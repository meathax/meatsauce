source "./source/jtcores/modules/jtframe/target/mister/hdl/sys/sys.tcl"
source "./source/jtcores/modules/jtframe/target/mister/hdl/sys/sys_analog.tcl"

set_global_assignment -name PRE_FLOW_SCRIPT_FILE "quartus_sh:./source/jtcores/modules/jtframe/target/mister/hdl/sys/build_id.tcl"
set_global_assignment -name SDC_FILE "./source/jtcores/modules/jtframe/target/mister/hdl/sys/sys_top.sdc"

# MiSTer Framework
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top
set_global_assignment -name QIP_FILE files.qip

set_global_assignment -name VERILOG_MACRO "ARCADE_SYS=1"
set_global_assignment -name VERILOG_MACRO "USE_SDRAM=1"

# AIRBLAST: removed stale legacy SDRAM capture packing assignment
