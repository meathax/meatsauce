# SWAT Police (ESD16) core file list. Edit here, not in the Quartus IDE.
set_global_assignment -name SDC_FILE Arcade-ESD16.sdc
set_global_assignment -name SYSTEMVERILOG_FILE ESD16.sv
set_global_assignment -name VERILOG_FILE rtl/pll/pll.v
set_global_assignment -name VERILOG_FILE rtl/pll/pll_0002.v
