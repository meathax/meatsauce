# Generated by scripts/framework_sources.py; pristine sys is the dependency base.
set _argus_framework_dir $::quartus(qip_path)
set _argus_framework_sys_dir "[file normalize [file join $_argus_framework_dir ../../sys]]/"
set_global_assignment -name QIP_FILE           [join [list $_argus_framework_sys_dir pll_q [regexp -inline {[0-9]+} $quartus(version)] .qip] {}]
