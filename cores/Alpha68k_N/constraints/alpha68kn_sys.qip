# Core-owned binding; all original QIP assignments retain original sys paths.
set a68_saved_qip_path $::quartus(qip_path)
set a68_constraints_path $a68_saved_qip_path
set a68_qip_status [catch {
 set a68_original_qip [file normalize [file join $a68_constraints_path .. sys sys.qip]]
 set a68_qip_f [open $a68_original_qip r]
 fconfigure $a68_qip_f -translation binary -encoding binary
 set a68_qip_bytes [read $a68_qip_f]
 close $a68_qip_f
 if {$a68_qip_bytes ne [binary format H* ]} {error {Original sys QIP pin changed}}
 set a68_original_sys_path "[file dirname $a68_original_qip]/"
 set a68_filtered_sdc [file join $a68_constraints_path alpha68kn_framework_audio.sdc]
set_global_assignment -name QIP_FILE           [join [list $a68_original_sys_path pll_q [regexp -inline {[0-9]+} $quartus(version)] .qip] {}]
set_global_assignment -name VERILOG_FILE       [file join $a68_original_sys_path sys_top.v ]
set_global_assignment -name SDC_FILE $a68_filtered_sdc
set_global_assignment -name VHDL_FILE          [file join $a68_original_sys_path ascal.vhd ]
set_global_assignment -name VHDL_FILE          [file join $a68_original_sys_path pll_hdmi_adj.vhd ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $a68_original_sys_path math.sv ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $a68_original_sys_path hq2x.sv ]
set_global_assignment -name VERILOG_FILE       [file join $a68_original_sys_path scandoubler.v ]
set_global_assignment -name VERILOG_FILE       [file join $a68_original_sys_path scanlines.v ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $a68_original_sys_path shadowmask.sv ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $a68_original_sys_path video_cleaner.sv ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $a68_original_sys_path gamma_corr.sv ]
set_global_assignment -name SYSTEMVERILOG_FILE [file normalize [file join $a68_constraints_path .. rtl alpha68kn_video_mixer.sv]]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $a68_original_sys_path video_freak.sv ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $a68_original_sys_path video_freezer.sv ]
set_global_assignment -name VERILOG_FILE       [file join $a68_original_sys_path arcade_video.v ]
set_global_assignment -name VERILOG_FILE       [file join $a68_original_sys_path osd.v ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $a68_original_sys_path vga_out.sv ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $a68_original_sys_path yc_out.sv ]
set_global_assignment -name VERILOG_FILE       [file join $a68_original_sys_path i2c.v ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $a68_original_sys_path alsa.sv ]
set_global_assignment -name VERILOG_FILE       [file join $a68_original_sys_path i2s.v ]
set_global_assignment -name VERILOG_FILE       [file join $a68_original_sys_path spdif.v ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $a68_original_sys_path audio_out.sv ]
set_global_assignment -name VERILOG_FILE       [file join $a68_original_sys_path iir_filter.v ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $a68_original_sys_path ltc2308.sv ]
set_global_assignment -name VERILOG_FILE       [file join $a68_original_sys_path sigma_delta_dac.v ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $a68_original_sys_path mt32pi.sv ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $a68_original_sys_path mcp23009.sv ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $a68_original_sys_path f2sdram_safe_terminator.sv ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $a68_original_sys_path ddr_svc.sv ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $a68_original_sys_path sysmem.sv ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $a68_original_sys_path sd_card.sv ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $a68_original_sys_path hps_io.sv ]
set_global_assignment -name SOURCE_FILE        [file join $a68_original_sys_path emu_ports.vh ]

} a68_qip_result]
set ::quartus(qip_path) $a68_saved_qip_path
unset a68_saved_qip_path a68_constraints_path
if {$a68_qip_status} {error $a68_qip_result}
unset a68_qip_status a68_qip_result a68_original_qip a68_qip_f a68_qip_bytes a68_filtered_sdc a68_original_sys_path
