# Core-owned read/evaluate wrapper; original sys_top.sdc remains byte-pinned.
set a68_original_sys_sdc [file normalize [file join [file dirname [info script]] .. sys sys_top.sdc]]
set a68_f [open $a68_original_sys_sdc r]
fconfigure $a68_f -translation binary -encoding binary
set a68_original_text [read $a68_f]
close $a68_f
if {$a68_original_text ne [binary format H* ]} {error {Original framework SDC bytes changed; review source pin before loading}}
set a68_original_text [encoding convertfrom utf-8 $a68_original_text]
# Match Tcl source channel newline normalization before evaluating original text.
set a68_original_text [string map [list "\r\n" "\n" "\r" "\n"] $a68_original_text]
set a68_expected [list {set_false_path -to   [get_ports {AUDIO_SPDIF}]} {set_false_path -to   [get_ports {AUDIO_L}]} {set_false_path -to   [get_ports {AUDIO_R}]}]
set a68_seen [list 0 0 0]
set a68_filtered {}
foreach a68_line [split $a68_original_text "\n"] {
    set a68_index [lsearch -exact $a68_expected [string trim $a68_line]]
    if {$a68_index >= 0} {
        lset a68_seen $a68_index [expr {[lindex $a68_seen $a68_index]+1}]
        append a68_filtered "\n"
    } else {append a68_filtered $a68_line "\n"}
}
if {$a68_seen ne {1 1 1}} {error {Original framework AUDIO clauses changed; refusing partial constraint load}}
uplevel #0 $a68_filtered
unset a68_original_sys_sdc a68_f a68_original_text a68_expected a68_seen a68_filtered a68_line a68_index
