{
  "source_contract": {
    "m68000.cpp": {
      "source": {
        "path": "D:\\Arcade\\AI\\mame289\\src\\devices\\cpu\\m68000\\m68000.cpp",
        "bytes": 14894,
        "sha256": "ef095e786564a203b828ed8e1e517b6af2e0d8fd64090d432f8be67480a5fab3"
      },
      "lines": [
        {
          "line": 435,
          "text": "\tif(inputnum > (m_interrupt_mixer ? 7 : 3))"
        },
        {
          "line": 436,
          "text": "\t\treturn;"
        },
        {
          "line": 437,
          "text": ""
        },
        {
          "line": 438,
          "text": "\tu32 old_level = m_int_level;"
        },
        {
          "line": 439,
          "text": "\tu32 vstate = m_virq_state;"
        },
        {
          "line": 440,
          "text": "\tu32 blevel;"
        },
        {
          "line": 441,
          "text": ""
        },
        {
          "line": 442,
          "text": "\tif(state == ASSERT_LINE)"
        },
        {
          "line": 443,
          "text": "\t\tvstate |= 1 << inputnum;"
        },
        {
          "line": 444,
          "text": "\telse"
        },
        {
          "line": 445,
          "text": "\t\tvstate &= ~(1 << inputnum);"
        },
        {
          "line": 446,
          "text": "\tm_virq_state = vstate;"
        },
        {
          "line": 447,
          "text": ""
        },
        {
          "line": 448,
          "text": "\tif(m_interrupt_mixer) {"
        },
        {
          "line": 449,
          "text": "\t\tfor(blevel = 7; blevel > 0; blevel--)"
        },
        {
          "line": 450,
          "text": "\t\t\tif(vstate & (1 << blevel))"
        },
        {
          "line": 451,
          "text": "\t\t\t\tbreak;"
        },
        {
          "line": 452,
          "text": "\t} else"
        },
        {
          "line": 453,
          "text": "\t\tblevel = vstate;"
        },
        {
          "line": 454,
          "text": ""
        },
        {
          "line": 455,
          "text": "\tm_int_level = blevel;"
        },
        {
          "line": 456,
          "text": ""
        },
        {
          "line": 457,
          "text": "\t/* A transition from < 7 to 7 always interrupts (NMI) */"
        },
        {
          "line": 458,
          "text": "\t/* Note: Level 7 can also level trigger like a normal IRQ */"
        },
        {
          "line": 459,
          "text": "\t// FIXME: This may cause unintended level 7 interrupts if one or two IPL lines are asserted"
        },
        {
          "line": 460,
          "text": "\t// immediately before others are cleared. The actual 68000 imposes an input hold time."
        },
        {
          "line": 461,
          "text": "\tif(old_level != 7 && m_int_level == 7)"
        },
        {
          "line": 462,
          "text": "\t\tm_nmi_pending = true;"
        },
        {
          "line": 463,
          "text": ""
        },
        {
          "line": 464,
          "text": "\tupdate_interrupt();"
        },
        {
          "line": 465,
          "text": "}"
        },
        {
          "line": 466,
          "text": ""
        },
        {
          "line": 467,
          "text": "void m68000_device::update_interrupt()"
        },
        {
          "line": 468,
          "text": "{"
        }
      ]
    },
