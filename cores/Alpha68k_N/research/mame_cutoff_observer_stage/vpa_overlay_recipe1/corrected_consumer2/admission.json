          "line": 745,
          "text": "\t// 234 itlx2"
        },
        {
          "line": 746,
          "text": "\tm_sr = (m_sr & ~SR_T) | SR_S;"
        },
        {
          "line": 747,
          "text": "\tupdate_user_super();"
        },
        {
          "line": 748,
          "text": "\tupdate_interrupt();"
        },
        {
          "line": 749,
          "text": "\tm_alub = m_ftu;"
        },
        {
          "line": 750,
          "text": "\tm_pc = m_au;"
        },
        {
          "line": 751,
          "text": "\tm_sr = (m_sr & ~SR_I) | ((m_next_state >> 16) & SR_I);"
        },
        {
          "line": 752,
          "text": "\tupdate_interrupt();"
        },
