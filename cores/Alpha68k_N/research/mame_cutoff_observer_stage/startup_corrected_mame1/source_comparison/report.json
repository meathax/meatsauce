  "source_contracts": {
    "MAME_reset": [
      {
        "path": "D:\\Arcade\\AI\\mame289\\src\\devices\\cpu\\m68000\\m68000-sdf.cpp",
        "sha256": "b46d977660c726d58509976d91d83cbf11682eb911032b807b0ee75ee7a1ca1c",
        "bytes": 4169290
      },
      [
        {
          "line": 120,
          "text": "\t// 2b7 trap8"
        },
        {
          "line": 121,
          "text": "\tm_aob = merge_16_32(high16(m_at), m_dbin);"
        },
        {
          "line": 122,
          "text": "\tm_au = merge_16_32(high16(m_at), m_dbin) + 2;"
        },
        {
          "line": 123,
          "text": "\tm_base_ssw = SSW_PROGRAM | SSW_R | SSW_N | SSW_CRITICAL;"
        },
        {
          "line": 124,
          "text": "\tm_edb = m_opcodes.read_interruptible(m_aob & ~1);"
        },
        {
          "line": 125,
          "text": "\tm_icount -= 4;"
        },
        {
          "line": 126,
          "text": "\tif(m_icount <= 0) {"
        },
        {
          "line": 127,
          "text": "\t\tif(access_to_be_redone()) {"
        },
        {
          "line": 128,
          "text": "\t\t\tm_icount += 4;"
        },
        {
          "line": 129,
          "text": "\t\t\tm_inst_substate = 9;"
        },
        {
          "line": 130,
          "text": "\t\t} else"
        },
        {
          "line": 131,
          "text": "\t\t\tm_inst_substate = 10;"
        },
        {
          "line": 132,
          "text": "\t\treturn;"
        },
        {
          "line": 133,
          "text": "\t}"
        },
        {
          "line": 134,
          "text": "\tif(m_aob & 1) {"
        },
        {
          "line": 135,
          "text": "\t\tm_icount -= 4;"
        },
        {
          "line": 136,
          "text": "\t\tm_inst_state = S_ADDRESS_ERROR;"
        },
        {
          "line": 137,
          "text": "\t\treturn;"
        },
        {
          "line": 138,
          "text": "\t}"
        },
        {
          "line": 139,
          "text": "\tm_irc = m_edb;"
        },
        {
          "line": 140,
          "text": "\t// 11c trap9"
        },
        {
          "line": 141,
          "text": "\tm_icount -= 2;"
        },
        {
          "line": 142,
          "text": "\t// 363 b"
        },
        {
          "line": 143,
          "text": "\tm_aob = m_au;"
        },
        {
          "line": 144,
          "text": "\tm_ir = m_irc;"
        },
        {
          "line": 145,
          "text": "\tm_pc = m_au;"
        },
        {
          "line": 146,
          "text": "\tm_au = m_au + 2;"
        },
        {
          "line": 147,
          "text": "\t// 34c mmrw3"
        },
        {
          "line": 148,
          "text": "\tm_ird = m_ir;"
        },
        {
          "line": 149,
          "text": "\tif(m_next_state != S_TRACE) m_next_state = m_int_next_state;"
        },
        {
          "line": 150,
          "text": "\tm_base_ssw = SSW_PROGRAM | SSW_R | SSW_N;"
        },
        {
          "line": 151,
          "text": "\tm_edb = m_opcodes.read_interruptible(m_aob & ~1);"
        },
        {
          "line": 152,
          "text": "\tm_icount -= 4;"
