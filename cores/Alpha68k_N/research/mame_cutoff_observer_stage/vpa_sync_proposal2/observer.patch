--- a/src/devices/cpu/m68000/m68000.cpp
+++ b/src/devices/cpu/m68000/m68000.cpp
@@ -102,14 +102,31 @@
 
 u64 m68000_device::vpa_sync(offs_t, u64 current_time)
 {
+
+	// BEGIN PRIVATE READONLY VPA REQUEST/RETURN OBSERVER
+	const u64 observe_previous_vpa = m_last_vpa_time;
+	const auto observe_vpa = [this, current_time, observe_previous_vpa](u64 result) -> u64 {
+		if (!strcmp(tag(), ":maincpu") && current_time >= 5500000 && current_time <= 6200000)
+			logerror("IRQ_VPA,%llu,%llu,%llu,%llu,%llu,%d,%llu,%llu,%u,%u,%u,%u,%u,%u,%u,%u,%u\n",
+				static_cast<unsigned long long>(current_time),
+				static_cast<unsigned long long>(observe_previous_vpa),
+				static_cast<unsigned long long>(result),
+				static_cast<unsigned long long>(current_time % 10),
+				static_cast<unsigned long long>(total_cycles()), m_icount,
+				static_cast<unsigned long long>(local_time().as_ticks(48000000)),
+				static_cast<unsigned long long>(machine().time().as_ticks(48000000)),
+				m_pc, m_ipc, m_ir, m_ird, m_irc, m_sr, m_int_level, m_int_next_state, m_next_state);
+		return result;
+	};
+	// END PRIVATE READONLY VPA REQUEST/RETURN OBSERVER
 	if(m_last_vpa_time >= current_time)
-		return m_last_vpa_time;
+		return observe_vpa(m_last_vpa_time);
 	u64 mod = current_time % 10;
 	if(mod < 7)
 		m_last_vpa_time = current_time - mod + 10;
 	else
 		m_last_vpa_time = current_time - mod + 20;
-	return m_last_vpa_time;
+	return observe_vpa(m_last_vpa_time);
 }
 
 u32 m68000_device::vpa_after(offs_t)
