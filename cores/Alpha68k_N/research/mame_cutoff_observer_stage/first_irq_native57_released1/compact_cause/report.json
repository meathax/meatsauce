  "FX_buswait_source_snippets": [
    {
      "line": 325,
      "text": "\tend"
    },
    {
      "line": 326,
      "text": "\t"
    },
    {
      "line": 327,
      "text": "\twire [3:0] tvn;"
    },
    {
      "line": 328,
      "text": "\twire waitBusCycle, busStarting;"
    },
    {
      "line": 329,
      "text": "\twire BusRetry = 1'b0;"
    },
    {
      "line": 330,
      "text": "\twire busAddrErr;"
    },
    {
      "line": 331,
      "text": "\twire bciWrite;\t\t\t\t\t\t// Last bus cycle was write"
    },
    {
      "line": 332,
      "text": "\twire bgBlock, busAvail;"
    },
    {
      "line": 368,
      "text": "\t"
    },
    {
      "line": 369,
      "text": "\tbusControl busControl( .Clks, .enT1, .enT4, .permStart( Nanod.permStart), .permStop( Nanod.waitBusFinish), .iStop,"
    },
    {
      "line": 370,
      "text": "\t\t.aob0, .isWrite( Nanod.isWrite), .isRmc( Nanod.isRmc), .isByte( busIsByte), .busAvail,"
    },
    {
      "line": 371,
      "text": "\t\t.bciWrite, .addrOe, .bgBlock, .waitBusCycle, .busStarting, .busAddrErr,"
    },
    {
      "line": 372,
      "text": "\t\t.rDtack, .BeDebounced, .Vpai,"
    },
    {
      "line": 373,
      "text": "\t\t.ASn, .LDSn, .UDSn, .eRWn);"
    },
    {
      "line": 374,
      "text": "\t\t"
    },
    {
      "line": 375,
      "text": "\tbusArbiter busArbiter( .Clks, .BRi, .BgackI, .Halti, .bgBlock, .busAvail, .BGn);"
    },
    {
      "line": 463,
      "text": "\tend"
    },
    {
      "line": 464,
      "text": "\t\t"
    },
    {
      "line": 465,
      "text": "\tassign enErrClk = iAddrErr | iBusErr;"
    },
    {
      "line": 466,
      "text": "\tassign wClk = waitBusCycle | ~BeI | iAddrErr | Err6591;"
    },
    {
      "line": 467,
      "text": "\t"
    },
    {
      "line": 468,
      "text": "\t// E clock and counter, VMA"
    },
    {
      "line": 469,
      "text": "\treg [3:0] eCntr;"
    },
    {
      "line": 470,
      "text": "\treg rVma;"
    },
    {
      "line": 472,
      "text": "\tassign VMAn = rVma;"
    },
    {
      "line": 473,
      "text": "\t"
    },
    {
      "line": 474,
      "text": "\t// Internal stop just one cycle before E falling edge"
    },
    {
      "line": 475,
      "text": "\twire xVma = ~rVma & (eCntr == 8);"
    },
    {
      "line": 476,
      "text": "\t"
    },
    {
      "line": 477,
      "text": "`ifdef USE_E_CLKEN"
    },
    {
      "line": 478,
      "text": "\tassign E_PosClkEn = (Clks.enPhi2 & (eCntr == 5));"
    },
    {
      "line": 479,
      "text": "\tassign E_NegClkEn = (Clks.enPhi2 & (eCntr == 9));"
    },
    {
      "line": 555,
      "text": "\t\telse if( Clks.enPhi1)"
    },
    {
      "line": 556,
      "text": "\t\t\tErr6591 <= enErrClk;"
    },
    {
      "line": 557,
      "text": "\t\telse if( Clks.enPhi2)"
    },
    {
      "line": 558,
      "text": "\t\t\tiStop <= xVma | (Vpai & (iAddrErr | ~rBerr));"
    },
    {
      "line": 559,
      "text": "\tend"
    },
    {
      "line": 560,
      "text": "\t"
    },
    {
      "line": 561,
      "text": "\t// PSW"
    },
    {
      "line": 562,
      "text": "\tlogic irdToCcr_t4;"
    },
    {
      "line": 2269,
      "text": "\t\tinput busAvail,"
    },
    {
      "line": 2270,
      "text": "\t\toutput bgBlock,"
    },
    {
      "line": 2271,
      "text": "\t\toutput busAddrErr,"
    },
    {
      "line": 2272,
      "text": "\t\toutput waitBusCycle,"
    },
    {
      "line": 2273,
      "text": "\t\toutput busStarting,\t\t\t// Asserted during S0"
    },
    {
      "line": 2274,
      "text": "\t\toutput logic addrOe,\t\t// Asserted from S1 to the end, whole bus cycle except S0"
    },
    {
      "line": 2275,
      "text": "\t\toutput bciWrite,\t\t\t// Used for SSW on bus/addr error"
    },
    {
      "line": 2276,
      "text": "\t\t"
    },
    {
      "line": 2347,
      "text": "\tassign bcReset = Clks.extReset | (addrOeDelay & BeDebounced & Vpai);"
    },
    {
      "line": 2348,
      "text": "\t\t"
    },
    {
      "line": 2349,
      "text": "\t// Enable uclock only on S6 (S8 on Bus Error) or not bciPermStop"
    },
    {
      "line": 2350,
      "text": "\tassign waitBusCycle = wendReg & !bcComplete;"
    },
    {
      "line": 2351,
      "text": "\t"
    },
