  "MAME_interrupt": {
    "source": {
      "path": "D:\\Arcade\\AI\\mame289\\src\\devices\\cpu\\m68000\\m68000-sdf.cpp",
      "bytes": 4169290,
      "sha256": "b46d977660c726d58509976d91d83cbf11682eb911032b807b0ee75ee7a1ca1c"
    },
    "PClo_IACK_SR": [
      {
        "line": 739,
        "text": "void m68000_device::state_interrupt_df()"
      },
      {
        "line": 740,
        "text": "{"
      },
      {
        "line": 741,
        "text": "\t// 1c4 itlx1"
      },
      {
        "line": 742,
        "text": "\tm_ftu = m_sr;"
      },
      {
        "line": 743,
        "text": "\tm_au = m_pc - 2;"
      },
      {
        "line": 744,
        "text": "\tm_icount -= 2;"
      },
      {
        "line": 745,
        "text": "\t// 234 itlx2"
      },
      {
        "line": 746,
        "text": "\tm_sr = (m_sr & ~SR_T) | SR_S;"
      },
      {
        "line": 747,
        "text": "\tupdate_user_super();"
      },
      {
        "line": 748,
        "text": "\tupdate_interrupt();"
      },
      {
        "line": 749,
        "text": "\tm_alub = m_ftu;"
      },
      {
        "line": 750,
        "text": "\tm_pc = m_au;"
      },
      {
        "line": 751,
        "text": "\tm_sr = (m_sr & ~SR_I) | ((m_next_state >> 16) & SR_I);"
      },
      {
        "line": 752,
        "text": "\tupdate_interrupt();"
      },
      {
        "line": 753,
        "text": "\t// alu r=0 c=1 m=.....  i=....... ALU.and_ a=R.aul:m_au d=-1"
      },
      {
        "line": 754,
        "text": "\talu_and(m_au, 0xffff);"
      },
      {
        "line": 755,
        "text": "\tm_icount -= 2;"
      },
      {
        "line": 756,
        "text": "\t// 235 itlx3"
      },
      {
        "line": 757,
        "text": "\tm_ftu = 0xfff0 | ((m_next_state >> 23) & 0xe);"
      },
      {
        "line": 758,
        "text": "\tm_au = m_da[16] - 2;"
      },
      {
        "line": 759,
        "text": "\tm_icount -= 2;"
      },
      {
        "line": 760,
        "text": "\t// 0eb itlx4"
      },
      {
        "line": 761,
        "text": "\tm_aob = m_au;"
      },
      {
        "line": 762,
        "text": "\tm_dbout = m_aluo;"
      },
      {
        "line": 763,
        "text": "\tm_at = ext32(m_ftu);"
      },
      {
        "line": 764,
        "text": "\tm_au = m_au - 4;"
      },
      {
        "line": 765,
        "text": "\t// alu r=0 c=1 m=.....  i=....... ALU.and_ a=alub d=-1"
      },
      {
        "line": 766,
        "text": "\talu_and(m_alub, 0xffff);"
      },
      {
        "line": 767,
        "text": "\tm_base_ssw = SSW_DATA | SSW_N;"
      },
      {
        "line": 768,
        "text": "\tm_program.write_interruptible(m_aob & ~1, m_dbout);"
      },
      {
        "line": 769,
        "text": "\tm_icount -= 4;"
      },
      {
        "line": 770,
        "text": "\tif(m_icount <= 0) {"
      },
      {
        "line": 771,
        "text": "\t\tif(access_to_be_redone()) {"
      },
      {
        "line": 772,
        "text": "\t\t\tm_icount += 4;"
      },
      {
        "line": 773,
        "text": "\t\t\tm_inst_substate = 1;"
      },
      {
        "line": 774,
        "text": "\t\t} else"
      },
      {
        "line": 775,
        "text": "\t\t\tm_inst_substate = 2;"
      },
      {
        "line": 776,
        "text": "\t\treturn;"
      },
      {
        "line": 777,
        "text": "\t}"
      },
      {
        "line": 778,
        "text": "\tif(m_aob & 1) {"
      },
      {
        "line": 779,
        "text": "\t\tm_icount -= 4;"
      },
      {
        "line": 780,
        "text": "\t\tm_inst_state = S_ADDRESS_ERROR;"
      },
      {
        "line": 781,
        "text": "\t\treturn;"
      },
      {
        "line": 782,
        "text": "\t}"
      },
      {
        "line": 783,
        "text": "\t// 236 itlx5"
      },
      {
        "line": 784,
        "text": "\tm_aob = m_at;"
      },
      {
        "line": 785,
        "text": "\tm_base_ssw = SSW_CPU | SSW_R | SSW_N;"
      },
      {
        "line": 786,
        "text": "\tstart_interrupt_vector_lookup();"
      },
      {
        "line": 787,
        "text": "\tm_edb = m_cpu_space.read_interruptible(m_aob);"
      },
      {
        "line": 788,
        "text": "\tm_icount -= 4;"
      },
      {
        "line": 789,
        "text": "\tif(m_icount <= 0) {"
      },
      {
        "line": 790,
        "text": "\t\tif(access_to_be_redone()) {"
      },
      {
        "line": 791,
        "text": "\t\t\tm_icount += 4;"
      },
      {
        "line": 792,
        "text": "\t\t\tm_inst_substate = 3;"
      },
      {
        "line": 793,
        "text": "\t\t} else"
      },
      {
        "line": 794,
        "text": "\t\t\tm_inst_substate = 4;"
      },
      {
        "line": 795,
        "text": "\t\treturn;"
      },
      {
        "line": 796,
        "text": "\t}"
      },
      {
        "line": 797,
        "text": "\tend_interrupt_vector_lookup();"
      },
      {
        "line": 798,
        "text": "\tif(m_aob & 1) {"
      },
      {
        "line": 799,
        "text": "\t\tm_icount -= 4;"
      },
      {
        "line": 800,
        "text": "\t\tm_inst_state = S_ADDRESS_ERROR;"
      },
