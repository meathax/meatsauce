{
  "MAME_E_timed_not_fixed_cycle": {
    "source": {
      "path": "D:\\Arcade\\AI\\mame289\\src\\devices\\cpu\\m68000\\m68000.cpp",
      "bytes": 14894,
      "sha256": "ef095e786564a203b828ed8e1e517b6af2e0d8fd64090d432f8be67480a5fab3"
    },
    "vpa_sync_after": [
      {
        "line": 103,
        "text": "u64 m68000_device::vpa_sync(offs_t, u64 current_time)"
      },
      {
        "line": 104,
        "text": "{"
      },
      {
        "line": 105,
        "text": "\tif(m_last_vpa_time >= current_time)"
      },
      {
        "line": 106,
        "text": "\t\treturn m_last_vpa_time;"
      },
      {
        "line": 107,
        "text": "\tu64 mod = current_time % 10;"
      },
      {
        "line": 108,
        "text": "\tif(mod < 7)"
      },
      {
        "line": 109,
        "text": "\t\tm_last_vpa_time = current_time - mod + 10;"
      },
      {
        "line": 110,
        "text": "\telse"
      },
      {
        "line": 111,
        "text": "\t\tm_last_vpa_time = current_time - mod + 20;"
      },
      {
        "line": 112,
        "text": "\treturn m_last_vpa_time;"
      },
      {
        "line": 113,
        "text": "}"
      },
      {
        "line": 114,
        "text": ""
      },
      {
        "line": 115,
        "text": "u32 m68000_device::vpa_after(offs_t)"
      },
      {
        "line": 116,
        "text": "{"
      },
      {
        "line": 117,
        "text": "\treturn 1;"
      },
      {
        "line": 118,
        "text": "}"
      }
    ],
    "autovector": [
      {
        "line": 207,
        "text": "void m68000_device::default_autovectors_map(address_map &map)"
      },
      {
        "line": 208,
        "text": "{"
      },
      {
        "line": 209,
        "text": "\tif(m_cpu_space_id == AS_CPU_SPACE && !has_configured_map(AS_CPU_SPACE)) {"
      },
      {
        "line": 210,
        "text": "\t\toffs_t mask = make_bitmask<offs_t>(m_cpu_space_config.m_addr_width) - 0xf;"
      },
      {
        "line": 211,
        "text": "\t\tmap(mask + 0x3, mask + 0x3).before_time(*this, FUNC(m68000_device::vpa_sync)).after_delay(*this, FUNC(m68000_device::vpa_after)).lr8(NAME([] () -> u8 { return autovector(1); }));"
      },
      {
        "line": 212,
        "text": "\t\tmap(mask + 0x5, mask + 0x5).before_time(*this, FUNC(m68000_device::vpa_sync)).after_delay(*this, FUNC(m68000_device::vpa_after)).lr8(NAME([] () -> u8 { return autovector(2); }));"
      },
      {
        "line": 213,
        "text": "\t\tmap(mask + 0x7, mask + 0x7).before_time(*this, FUNC(m68000_device::vpa_sync)).after_delay(*this, FUNC(m68000_device::vpa_after)).lr8(NAME([] () -> u8 { return autovector(3); }));"
      },
      {
        "line": 214,
        "text": "\t\tmap(mask + 0x9, mask + 0x9).before_time(*this, FUNC(m68000_device::vpa_sync)).after_delay(*this, FUNC(m68000_device::vpa_after)).lr8(NAME([] () -> u8 { return autovector(4); }));"
      },
      {
        "line": 215,
        "text": "\t\tmap(mask + 0xb, mask + 0xb).before_time(*this, FUNC(m68000_device::vpa_sync)).after_delay(*this, FUNC(m68000_device::vpa_after)).lr8(NAME([] () -> u8 { return autovector(5); }));"
      },
      {
        "line": 216,
        "text": "\t\tmap(mask + 0xd, mask + 0xd).before_time(*this, FUNC(m68000_device::vpa_sync)).after_delay(*this, FUNC(m68000_device::vpa_after)).lr8(NAME([] () -> u8 { return autovector(6); }));"
      },
      {
        "line": 217,
        "text": "\t\tmap(mask + 0xf, mask + 0xf).before_time(*this, FUNC(m68000_device::vpa_sync)).after_delay(*this, FUNC(m68000_device::vpa_after)).lr8(NAME([] () -> u8 { return autovector(7); }));"
      }
    ],
    "meaning": "CPUspace autovector maps synchronize to cyclesmod10, threshold7 roundsnext10/20, thenafter_delay1. Do not characterize this as genericfixed-cycleIACK or equate CPUcycleswithmachineas_ticks."
  },
  "FX_E_VPA": {
    "source": {
      "path": "D:\\Arcade\\AI\\aCORES\\Alpha68k N\\rtl\\vendor\\fx68k\\fx68k.sv",
      "bytes": 79694,
      "sha256": "797566aa6c1dfb308d88a458550d55f86e0d023e670ab179cc39f594d9d4f73d"
    },
    "sample": [
      {
        "line": 214,
        "text": "\talways_ff @( posedge Clks.clk) begin"
      },
      {
        "line": 215,
        "text": "\t\tif( Clks.pwrUp) begin"
      },
      {
        "line": 216,
        "text": "\t\t\trBerr <= 1'b0;"
      },
      {
        "line": 217,
        "text": "\t\t\tBeI <= 1'b0;"
      },
      {
        "line": 218,
        "text": "\t\tend"
      },
      {
        "line": 219,
        "text": "\t\telse if( Clks.enPhi2) begin"
      },
      {
        "line": 220,
        "text": "\t\t\trDtack <= DTACKn;"
      },
      {
        "line": 221,
        "text": "\t\t\trBerr <= BERRn;"
      },
      {
        "line": 222,
        "text": "\t\t\trIpl <= ~{ IPL2n, IPL1n, IPL0n};"
      },
      {
        "line": 223,
        "text": "\t\t\tiIpl <= rIpl;"
      },
      {
        "line": 224,
        "text": "\t\t\t"
      },
      {
        "line": 225,
        "text": "\t\t\t// Needed for cycle accuracy but only if BR or HALT are asserted on the wrong edge of the clock\t\t\t"
      },
      {
        "line": 226,
        "text": "\t\t\t// rBR <= BRn;"
      },
      {
        "line": 227,
        "text": "\t\t\t// rHALT <= HALTn;"
      },
      {
        "line": 228,
        "text": "\t\tend"
      },
      {
        "line": 229,
        "text": "\t\telse if( Clks.enPhi1) begin"
      },
      {
        "line": 230,
        "text": "\t\t\tVpai <= VPAn;"
      },
      {
        "line": 231,
        "text": "\t\t\tBeI <= rBerr;"
      },
      {
        "line": 232,
        "text": "\t\t\tBeiDelay <= BeI;"
      },
      {
        "line": 233,
        "text": "\t\t\tBgackI <= BGACKn;"
      },
      {
        "line": 234,
        "text": "\t\t\t"
      },
      {
        "line": 235,
        "text": "\t\t\tBRi <= BRn;"
      },
      {
        "line": 236,
        "text": "\t\t\tHalti <= HALTn;"
      },
      {
        "line": 237,
        "text": "\t\t\t// BRi <= rBR;"
      },
      {
        "line": 238,
        "text": "\t\t\t// Halti <= rHALT;\t\t\t"
      },
      {
        "line": 239,
        "text": "\t\tend\t"
      }
    ],
    "clock_wait_E": [
      {
        "line": 465,
        "text": "\tassign enErrClk = iAddrErr | iBusErr;"
      },
      {
        "line": 466,
        "text": "\tassign wClk = waitBusCycle | ~BeI | iAddrErr | Err6591;"
      },
      {
        "line": 467,
        "text": "\t"
      },
      {
        "line": 468,
        "text": "\t// E clock and counter, VMA"
      },
      {
        "line": 469,
        "text": "\treg [3:0] eCntr;"
      },
      {
        "line": 470,
        "text": "\treg rVma;"
      },
      {
        "line": 471,
        "text": "\t"
      },
      {
        "line": 472,
        "text": "\tassign VMAn = rVma;"
      },
      {
        "line": 473,
        "text": "\t"
      },
      {
        "line": 474,
        "text": "\t// Internal stop just one cycle before E falling edge"
      },
      {
        "line": 475,
        "text": "\twire xVma = ~rVma & (eCntr == 8);"
      },
      {
        "line": 476,
        "text": "\t"
      },
      {
        "line": 477,
        "text": "`ifdef USE_E_CLKEN"
      },
      {
        "line": 478,
        "text": "\tassign E_PosClkEn = (Clks.enPhi2 & (eCntr == 5));"
      },
      {
        "line": 479,
        "text": "\tassign E_NegClkEn = (Clks.enPhi2 & (eCntr == 9));"
      },
      {
        "line": 480,
        "text": "`endif"
      },
      {
        "line": 481,
        "text": "\t"
      },
      {
        "line": 482,
        "text": "\talways_ff @( posedge Clks.clk) begin"
      },
      {
        "line": 483,
        "text": "\t\tif( Clks.pwrUp) begin"
      },
      {
        "line": 484,
        "text": "\t\t\tE <= 1'b0;"
      },
      {
        "line": 485,
        "text": "\t\t\teCntr <='0;"
      },
      {
        "line": 486,
        "text": "\t\t\trVma <= 1'b1;"
      },
      {
        "line": 487,
        "text": "\t\tend"
      },
      {
        "line": 488,
        "text": "\t\tif( Clks.enPhi2) begin"
      },
      {
        "line": 489,
        "text": "\t\t\tif( eCntr == 9)"
      },
      {
        "line": 490,
        "text": "\t\t\t\tE <= 1'b0;"
      },
      {
        "line": 491,
        "text": "\t\t\telse if( eCntr == 5)"
      },
      {
        "line": 492,
        "text": "\t\t\t\tE <= 1'b1;"
      },
      {
        "line": 493,
        "text": ""
      },
      {
        "line": 494,
        "text": "\t\t\tif( eCntr == 9)"
      },
      {
        "line": 495,
        "text": "\t\t\t\teCntr <= '0;"
      },
      {
        "line": 496,
        "text": "\t\t\telse"
      },
      {
        "line": 497,
        "text": "\t\t\t\teCntr <= eCntr + 1'b1;"
      },
      {
        "line": 498,
        "text": "\t\tend"
      },
      {
        "line": 499,
        "text": "\t\t"
      },
      {
        "line": 500,
        "text": "\t\tif( Clks.enPhi2 & addrOe & ~Vpai & (eCntr == 3))"
      },
      {
        "line": 501,
        "text": "\t\t\trVma <= 1'b0;"
      },
      {
        "line": 502,
        "text": "\t\telse if( Clks.enPhi1 & eCntr == '0)"
      },
      {
        "line": 503,
        "text": "\t\t\trVma <= 1'b1;"
      }
    ],
    "meaning": "ExternalVPAn sampled enPhi1; Ecounter increments enPhi2 mod10, VMAstarts atcounter3, xVmastop at8, VMAreleasecounter0. E/xVma observervalues derivedfromsourcecounter/registeredVMA and taggedasderived."
  },
