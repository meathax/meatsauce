        },
        {
          "line": 52,
          "text": "    );"
        },
        {
          "line": 53,
          "text": "    a68n_ay49 #(.MUTE_NULL_PERIOD(0),.CLKDIV(3),.COMP(0),.YM2203_LUMPED(0)) ay2 ("
