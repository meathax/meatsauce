        {
          "line": 40,
          "text": "        .cs_n(!(ym_write || ym_read)),.wr_n(!ym_write),.dout(ym_dout),.irq_n(ym_irq_n),"
        },
        {
          "line": 41,
          "text": "        .IOA_in(8'hff),.IOB_in(8'hff),.IOA_out(),.IOB_out(),.IOA_oe(),.IOB_oe(),"
        },
        {
          "line": 42,
          "text": "        .psg_A(),.psg_B(),.psg_C(),.fm_snd(fm),.psg_snd(ym_psg),"
        },
        {
          "line": 43,
          "text": "        .snd(),.snd_sample(ym_sample),.debug_view()"
        },
        {
          "line": 44,
          "text": "    );"
        },
        {
          "line": 45,
          "text": "    // MUTE_NULL_PERIOD=0 is AY period-zero-as-one; SEL=1 gives AY /8 tone clock."
        },
        {
          "line": 46,
          "text": "    // Namespaced external core quantizes envelopes to AY16 and uses AY transfer."
        },
        {
          "line": 47,
          "text": "    a68n_ay49 #(.MUTE_NULL_PERIOD(0),.CLKDIV(3),.COMP(0),.YM2203_LUMPED(0)) ay1 ("
        },
        {
          "line": 48,
          "text": "        .rst_n(!reset),.clk(clk),.clk_en(cen),.addr(ay1_addr),.cs_n(!ay1_write),"
        },
        {
          "line": 49,
          "text": "        .wr_n(!ay1_write),.din(io_data),.sel(1'b1),.dout(ay1_dout),.sound(ay1_psg),"
