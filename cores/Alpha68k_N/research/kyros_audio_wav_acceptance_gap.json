  "chip_clock_source": {
    "rtl/alpha68kn_soundchips.sv": {
      "sha256": "5031188ac069c50e0deb4594947395b5440ac288e41f29c09fec8a80e1a45e37",
      "lines": [
        {
          "line": 1,
          "text": "// One 48 MHz master; three 2 MHz sound chips use the same enable."
        },
        {
          "line": 2,
          "text": "// Address/data strobes are captured on master edges, as required by the donors."
        },
        {
          "line": 3,
          "text": "module alpha68kn_soundchips ("
        },
        {
          "line": 4,
          "text": "    input wire clk,reset,io_wr,io_rd,"
        },
        {
          "line": 5,
          "text": "    input wire [7:0] io_addr,io_data,read_addr,"
        },
        {
          "line": 6,
          "text": "    output wire [7:0] read_data,"
        },
        {
          "line": 7,
          "text": "    output wire signed [15:0] fm,"
        },
        {
          "line": 8,
          "text": "    output wire [9:0] ym_psg,ay1_psg,ay2_psg,"
        },
        {
          "line": 9,
          "text": "    output wire [7:0] ay1_a,ay1_b,ay1_c,ay2_a,ay2_b,ay2_c,"
        },
        {
          "line": 10,
          "text": "    output wire ym_irq_n,ym_sample,"
        },
        {
          "line": 11,
          "text": "    output reg [31:0] ym_writes,ay1_writes,ay2_writes"
        },
        {
          "line": 12,
          "text": ");"
        },
        {
          "line": 13,
          "text": "    reg [4:0] phase;"
        },
        {
          "line": 14,
          "text": "    wire cen=phase==0;"
        },
        {
          "line": 15,
          "text": "    reg [3:0] ay1_addr,ay2_addr;"
        },
        {
          "line": 16,
          "text": "    wire [7:0] ym_dout,ay1_dout,ay2_dout;"
        },
        {
          "line": 17,
          "text": "    wire ym_write=io_wr && io_addr[7:1]==7'h08;"
        },
        {
          "line": 18,
          "text": "    wire ym_read=io_rd && read_addr[7:1]==7'h08;"
        },
        {
          "line": 19,
          "text": "    wire ay1_write=io_wr && io_addr==8'h80;"
        },
        {
          "line": 20,
          "text": "    wire ay2_write=io_wr && io_addr==8'h90;"
        },
        {
          "line": 21,
          "text": "    // Data readback uses the live query address, independently of last writes."
        },
        {
          "line": 22,
          "text": "    assign read_data=read_addr[7:1]==7'h08 ? ym_dout :"
        },
        {
          "line": 23,
          "text": "                     read_addr==8'h80 ? ay1_dout : read_addr==8'h90 ? ay2_dout : 8'hff;"
        },
        {
          "line": 24,
          "text": "    always @(posedge clk) begin"
        },
        {
          "line": 25,
          "text": "        if(reset) begin"
        },
        {
          "line": 26,
          "text": "            phase<=0;ay1_addr<=0;ay2_addr<=0;"
        },
        {
          "line": 27,
          "text": "            ym_writes<=0;ay1_writes<=0;ay2_writes<=0;"
        },
        {
          "line": 28,
          "text": "        end else begin"
        },
        {
          "line": 29,
          "text": "            phase<=phase==23 ? 0 : phase+1'b1;"
        },
        {
          "line": 30,
          "text": "            if(io_wr && io_addr==8'h81) ay1_addr<=io_data[3:0];"
        },
        {
          "line": 31,
          "text": "            if(io_wr && io_addr==8'h91) ay2_addr<=io_data[3:0];"
        },
        {
          "line": 32,
          "text": "            if(ym_write) ym_writes<=ym_writes+1'b1;"
        },
        {
          "line": 33,
          "text": "            if(ay1_write || (io_wr && io_addr==8'h81)) ay1_writes<=ay1_writes+1'b1;"
        },
        {
          "line": 34,
          "text": "            if(ay2_write || (io_wr && io_addr==8'h91)) ay2_writes<=ay2_writes+1'b1;"
        },
        {
          "line": 35,
          "text": "        end"
        },
        {
          "line": 36,
          "text": "    end"
        },
        {
          "line": 37,
          "text": "    // YM2203 preserves its donor's own embedded YM SSG and clock division."
        },
        {
          "line": 38,
          "text": "    jt03 #(.SSG_COMP(3'd5)) ym ("
        },
        {
          "line": 39,
          "text": "        .rst(reset),.clk(clk),.cen(cen),.din(io_data),.addr(io_wr ? io_addr[0] : read_addr[0]),"
