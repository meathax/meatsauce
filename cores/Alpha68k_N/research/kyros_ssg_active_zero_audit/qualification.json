  "interface_source_pins_and_excerpts": [
    {
      "path": "D:\\Arcade\\AI\\aCORES\\meatsauce-alpha68kn\\cores\\Alpha68k_N\\rtl\\alpha68kn_soundchips.sv",
      "sha256": "5031188ac069c50e0deb4594947395b5440ac288e41f29c09fec8a80e1a45e37",
      "bytes": 3088,
      "relative_path": "rtl/alpha68kn_soundchips.sv",
      "excerpts": [
        {
          "first_line": 17,
          "last_line": 18,
          "text": "    wire ym_write=io_wr && io_addr[7:1]==7'h08;\n    wire ym_read=io_rd && read_addr[7:1]==7'h08;"
        },
        {
          "first_line": 38,
          "last_line": 42,
          "text": "    jt03 #(.SSG_COMP(3'd5)) ym (\n        .rst(reset),.clk(clk),.cen(cen),.din(io_data),.addr(io_wr ? io_addr[0] : read_addr[0]),\n        .cs_n(!(ym_write || ym_read)),.wr_n(!ym_write),.dout(ym_dout),.irq_n(ym_irq_n),\n        .IOA_in(8'hff),.IOB_in(8'hff),.IOA_out(),.IOB_out(),.IOA_oe(),.IOB_oe(),\n        .psg_A(),.psg_B(),.psg_C(),.fm_snd(fm),.psg_snd(ym_psg),"
        }
      ]
    },
    {
      "path": "D:\\Arcade\\AI\\aCORES\\meatsauce-alpha68kn\\cores\\Alpha68k_N\\rtl\\vendor\\jt12\\hdl\\jt12_top.v",
      "sha256": "199dcfe54ba43ccf2e142eaa5ee82e0a63ba5fcfb5681b658b1fee1f5af72f3d",
      "bytes": 22817,
      "relative_path": "rtl/vendor/jt12/hdl/jt12_top.v",
      "excerpts": [
        {
          "first_line": 87,
          "last_line": 87,
          "text": "wire write = !cs_n && !wr_n;"
        },
        {
          "first_line": 405,
          "last_line": 407,
          "text": "    .psg_addr   ( psg_addr  ),\n    .psg_data   ( psg_data  ),\n    .psg_wr_n   ( psg_wr_n  ),"
        },
        {
          "first_line": 461,
          "last_line": 469,
          "text": "        jt49 #(.COMP(SSG_COMP), .CLKDIV(JT49_DIV), .YM2203_LUMPED(YM2203_LUMPED))\n            u_psg( // note that input ports are not multiplexed\n            .rst_n      ( ~rst      ),\n            .clk        ( clk       ),    // signal on positive edge\n            .clk_en     ( clk_en_ssg),    // clock enable on negative edge\n            .addr       ( psg_addr  ),\n            .cs_n       ( 1'b0      ),\n            .wr_n       ( psg_wr_n  ),  // write\n            .din        ( psg_data  ),"
        }
      ]
    },
    {
      "path": "D:\\Arcade\\AI\\aCORES\\meatsauce-alpha68kn\\cores\\Alpha68k_N\\rtl\\vendor\\jt12\\hdl\\jt12_mmr.v",
      "sha256": "019063a77e636053eebbc11b91c3e4903401330f05b86093750357bc5916fc47",
      "bytes": 19944,
      "relative_path": "rtl/vendor/jt12/hdl/jt12_mmr.v",
      "excerpts": [
        {
          "first_line": 187,
          "last_line": 188,
          "text": "        assign psg_addr = selected_register[3:0];\n        assign psg_data = ch_din;"
        },
        {
          "first_line": 270,
          "last_line": 297,
          "text": "        if( write ) begin\n            if( !addr[0] ) begin\n                selected_register <= din;  \n                part <= addr[1];        \n                if (!mask_div)\n                case(din)\n                    // clock divider: should work only for ym2203\n                    // and ym2608.\n                    // clock divider works just by selecting the register\n                    REG_CLK_N6: div_setting[1] <= 1'b1; // 2D\n                    REG_CLK_N3: div_setting[0] <= 1'b1; // 2E\n                    REG_CLK_N2: div_setting    <= 2'b0; // 2F\n                    default:;\n                endcase\n            end else if( part == addr[1] ) begin\n                // Global registers\n                ch_din <= din;\n                if( selected_register == REG_KON && !part ) begin\n                    up_keyon <= 1;\n                    op_din   <= din;\n                end else begin\n                    up_keyon <= 0;\n                end\n                // General control (<0x20 registers and A0==0)\n                if(!part) begin\n                    casez( selected_register)\n                        //REG_TEST: lfo_rst <= 1'b1; // regardless of din\n                        8'h0?: psg_wr_n <= 1'b0;"
        },
        {
          "first_line": 420,
          "last_line": 423,
          "text": "        else if(clk_en) begin /* clear once-only bits */\n            // lfo_rst <= 1'b0;\n            { clr_flag_B, clr_flag_A } <= 2'd0;\n            psg_wr_n <= 1'b1;"
        }
      ]
    },
    {
      "path": "D:\\Arcade\\AI\\aCORES\\meatsauce-alpha68kn\\cores\\Alpha68k_N\\rtl\\vendor\\jt12\\jt49\\hdl\\jt49.v",
      "sha256": "69808b2f4343083ba187936af31e49a8344302e214fdb1bdeaf0fb92b0f8ced6",
      "bytes": 7601,
      "relative_path": "rtl/vendor/jt12/jt49/hdl/jt49.v",
      "excerpts": [
        {
          "first_line": 168,
          "last_line": 174,
          "text": "    Amix <= (noise|use_noA) & (bitA|regarray[7][0]);\n    Bmix <= (noise|use_noB) & (bitB|regarray[7][1]);\n    Cmix <= (noise|use_noC) & (bitC|regarray[7][2]);\n\n    logA <= !Amix ? 5'd0 : (use_envA ? envelope : volA );\n    logB <= !Bmix ? 5'd0 : (use_envB ? envelope : volB );\n    logC <= !Cmix ? 5'd0 : (use_envC ? envelope : volC );"
        },
        {
          "first_line": 236,
          "last_line": 255,
          "text": "always @(posedge clk, negedge rst_n) begin\n    if( !rst_n ) begin\n        dout       <= 8'd0;\n        last_write <= 0;\n        eg_restart <= 0;\n        regarray[0]<=8'd0; regarray[4]<=8'd0; regarray[ 8]<=8'd0; regarray[12]<=8'd0;\n        regarray[1]<=8'd0; regarray[5]<=8'd0; regarray[ 9]<=8'd0; regarray[13]<=8'd0;\n        regarray[2]<=8'd0; regarray[6]<=8'd0; regarray[10]<=8'd0; regarray[14]<=8'd0;\n        regarray[3]<=8'd0; regarray[7]<=8'd0; regarray[11]<=8'd0; regarray[15]<=8'd0;\n    end else begin\n        last_write  <= write;\n        // Data read\n        case( addr )\n            4'he: dout <= port_A;\n            4'hf: dout <= port_B;\n            default: dout <= regarray[ addr ] & read_mask;\n        endcase\n        // Data write\n        if( write ) begin\n            regarray[addr] <= din;"
        }
      ]
    }
  ],
