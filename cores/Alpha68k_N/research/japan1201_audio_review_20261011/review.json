      "path": "rtl/alpha68kn_board.sv",
      "line": 199,
      "text": "response_kind==2 ? strip_q : mdin_other;"
    },
    {
      "path": "rtl/alpha68kn_board.sv",
      "line": 208,
      "text": "assign debug_main_din = mdin;"
