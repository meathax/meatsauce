    {
      "path": "rtl/alpha68kn_board.sv",
      "line": 231,
      "text": ".command_addr(ma[8:1]),.command_data(mdout[7:0]),.coins_n(coins_n),"
    },
    {
      "path": "rtl/alpha68kn_board.sv",
      "line": 248,
      "text": ".iEdb(mdin), .oEdb(mdout), .eab(ma)"
    },
    {
      "path": "rtl/alpha68kn_board.sv",
      "line": 331,
      "text": "wire [7:0] work_data_hi=hs_work_service ? hs_data_in : mdout[15:8];"
    },
    {
      "path": "rtl/alpha68kn_board.sv",
      "line": 332,
      "text": "wire [7:0] work_data_lo=sting_mcu_work_service ? sting_mcu_shared_data : hs_work_service ? hs_data_in : cpu_work_service ? mdout[7:0] :"
    },
    {
      "path": "rtl/alpha68kn_board.sv",
      "line": 369,
      "text": "strip_hi[ma[12:1]]<=mdout[15:8];"
    },
    {
      "path": "rtl/alpha68kn_board.sv",
