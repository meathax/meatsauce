      "text": "renderer_strip_hi[ma[12:1]]<=mdout[15:8];"
    },
    {
      "path": "rtl/alpha68kn_board.sv",
      "line": 373,
      "text": "strip_lo[ma[12:1]]<=mdout[7:0];"
    },
    {
      "path": "rtl/alpha68kn_board.sv",
      "line": 374,
      "text": "renderer_strip_lo[ma[12:1]]<=mdout[7:0];"
    },
    {
      "path": "rtl/alpha68kn_board.sv",
      "line": 390,
      "text": "flip<=0;dac<=0;mdin_other<=16'hffff;response_kind<=0;"
    },
    {
      "path": "rtl/alpha68kn_board.sv",
      "line": 417,
      "text": "// Legacy mdin holds during pause and after resume until next service."
    },
    {
      "path": "rtl/alpha68kn_board.sv",
      "line": 418,
      "text": "if(pause_game && !paused) begin mdin_other<=mdin;response_kind<=0;end"
    },
    {
      "path": "rtl/alpha68kn_board.sv",
      "line": 427,
      "text": "mdin_other<=16'hffff;response_kind<=0;"
    },
    {
      "path": "rtl/alpha68kn_board.sv",
      "line": 431,
      "text": "end else if (maddr < 'h020000) mdin_other<=main_rom_q;"
    },
    {
      "path": "rtl/alpha68kn_board.sv",
      "line": 439,
      "text": "mdin_other<=background;"
    },
    {
      "path": "rtl/alpha68kn_board.sv",
      "line": 441,
      "text": "if (!muds_n) background[15:8]<=mdout[15:8];"
    },
    {
      "path": "rtl/alpha68kn_board.sv",
      "line": 442,
      "text": "if (!mlds_n) background[7:0]<=mdout[7:0];"
    },
    {
      "path": "rtl/alpha68kn_board.sv",
      "line": 445,
      "text": "mdin_other<=is_stingray ? 16'hff00 : 16'd0;"
    },
    {
      "path": "rtl/alpha68kn_board.sv",
      "line": 451,
      "text": "if (ma[8:1]=='h2d && !mlds_n) flip<=mdout[0];"
    },
    {
      "path": "rtl/alpha68kn_board.sv",
      "line": 471,
      "text": "end else if (maddr=='h0c0000) mdin_other<=controls;"
    },
    {
      "path": "rtl/alpha68kn_board.sv",
      "line": 473,
      "text": "mdin_other<={dips,8'hff};"
    },
    {
      "path": "rtl/alpha68kn_board.sv",
      "line": 474,
      "text": "if (!mrw_n && !muds_n) begin sound_latch<=mdout[15:8];sound_latch_pending<=1; end"
    },
    {
      "path": "Alpha68k_N.sv",
