  "source": {
    "rtl/alpha68kn_mixer.sv": {
      "sha256": "93df0e2464cae387fc473bbcab830494d043c3d219fc3f3c5fff69ed67cc40f0",
      "lines": [
        {
          "line": 1,
          "text": "// MAME 0.289 nominal mono routes: YMFM SSG and legacy standalone AY differ."
        },
        {
          "line": 2,
          "text": "// Inputs are donor numerical samples; physical analog calibration remains separate."
        },
        {
          "line": 3,
          "text": "module alpha68kn_mixer ("
        },
        {
          "line": 4,
          "text": "    input wire clk,reset,"
        },
        {
          "line": 5,
          "text": "    input wire [7:0] profile,dac,"
        },
        {
          "line": 6,
          "text": "    input wire signed [15:0] fm,"
        },
        {
          "line": 7,
          "text": "    input wire [9:0] ym_psg,ay1_psg,ay2_psg,"
        },
        {
          "line": 8,
          "text": "    output reg signed [15:0] sample,"
        },
        {
          "line": 9,
          "text": "    output reg sample_ce,"
        },
        {
          "line": 10,
          "text": "    output reg [31:0] clipped_samples"
        },
        {
          "line": 11,
          "text": ");"
        },
        {
          "line": 12,
          "text": "    // Q16: FM route .30. YMFM SSG maps each channel u8 to [0,16382]."
        },
        {
          "line": 13,
          "text": "    // Standalone AY maps each channel u8 to [-.125,.375] of full scale,"
        },
        {
          "line": 14,
          "text": "    // matching build_single_table before MAME's frontend limiter."
        },
        {
          "line": 15,
          "text": "    // PSG gains .30/.30/.60 (Kyros/Japan), .30/.30/.45 (Stingray); DAC .50."
        },
        {
          "line": 16,
          "text": "    reg signed [39:0] fm_q,ym_q,ay1_q,ay2_q,dac_q;"
        },
        {
          "line": 17,
          "text": "    reg signed [39:0] pair0_q,pair1_q,dac_delay_q,mix_q;"
        },
        {
          "line": 18,
          "text": "    wire signed [39:0] pcm=mix_q >>> 16;"
        },
        {
          "line": 19,
          "text": "    reg [9:0] sample_div;"
        },
        {
          "line": 20,
          "text": "    always @(posedge clk) begin"
        },
        {
          "line": 21,
          "text": "        if(reset) begin"
        },
        {
          "line": 22,
          "text": "            fm_q<=0;ym_q<=0;ay1_q<=0;ay2_q<=0;dac_q<=0;"
        },
        {
          "line": 23,
          "text": "            pair0_q<=0;pair1_q<=0;dac_delay_q<=0;mix_q<=0;"
        },
        {
          "line": 24,
          "text": "            sample<=0;sample_ce<=0;sample_div<=0;clipped_samples<=0;"
        },
        {
          "line": 25,
          "text": "        end else begin"
        },
        {
          "line": 26,
          "text": "            fm_q <= $signed(fm) * 40'sd19661;"
        },
        {
          "line": 27,
          "text": "            ym_q <= $signed({1'b0,ym_psg}) * 40'sd1263071;"
        },
        {
          "line": 28,
          "text": "            ay1_q <= $signed({1'b0,ay1_psg}) * 40'sd1263226 - 40'sd241591910;"
        },
        {
          "line": 29,
          "text": "            ay2_q <= $signed({1'b0,ay2_psg}) *"
        },
        {
          "line": 30,
          "text": "                (profile==2 ? 40'sd1894839 : 40'sd2526451) -"
        },
        {
          "line": 31,
          "text": "                (profile==2 ? 40'sd362387866 : 40'sd483183821);"
        },
        {
          "line": 32,
          "text": "            dac_q <= ($signed({1'b0,dac})-40'sd128) * 40'sd8388608;"
        },
        {
          "line": 33,
          "text": "            pair0_q<=fm_q+ym_q;pair1_q<=ay1_q+ay2_q;dac_delay_q<=dac_q;"
        },
        {
          "line": 34,
          "text": "            mix_q<=pair0_q+pair1_q+dac_delay_q;"
        },
        {
          "line": 35,
          "text": "            sample_ce<=sample_div==999;"
        },
        {
          "line": 36,
          "text": "            sample_div<=sample_div==999 ? 0 : sample_div+1'b1;"
        },
        {
          "line": 37,
          "text": "            if(sample_div==999) begin"
        },
        {
          "line": 38,
          "text": "                if(pcm>32767) begin sample<=32767;clipped_samples<=clipped_samples+1'b1;end"
        },
        {
          "line": 39,
          "text": "                else if(pcm< -32768) begin sample<=-32768;clipped_samples<=clipped_samples+1'b1;end"
        },
        {
          "line": 40,
          "text": "                else sample<=pcm[15:0];"
        },
        {
          "line": 41,
          "text": "            end"
        },
        {
          "line": 42,
          "text": "        end"
        },
        {
          "line": 43,
          "text": "    end"
        },
        {
          "line": 44,
          "text": "endmodule"
        }
      ]
    },
    "rtl/alpha68kn_soundchips.sv": {
      "sha256": "5031188ac069c50e0deb4594947395b5440ac288e41f29c09fec8a80e1a45e37",
      "lines": []
    },
    "rtl/alpha68kn_audio.sv": {
      "sha256": "1aa458aab8c8ebbf061c6f371cbd506cbc1b3a5d21206f2006532ff70be6113e",
      "lines": [
        {
          "line": 6,
          "text": "    output wire signed [15:0] sample,"
        },
        {
          "line": 7,
          "text": "    output wire sample_ce,"
        },
        {
          "line": 8,
          "text": "    output wire [31:0] clipped_samples,"
        },
        {
          "line": 9,
          "text": "    output wire signed [15:0] debug_fm,"
        },
        {
          "line": 10,
          "text": "    output wire [9:0] debug_ym_psg,debug_ay1_psg,debug_ay2_psg,"
        },
        {
          "line": 11,
          "text": "    output wire [31:0] ym_writes,ay1_writes,ay2_writes"
        },
        {
          "line": 21,
          "text": "        .clk(clk),.reset(reset),.profile(profile),.dac(dac),.fm(debug_fm),"
        },
        {
          "line": 22,
          "text": "        .ym_psg(debug_ym_psg),.ay1_psg(debug_ay1_psg),.ay2_psg(debug_ay2_psg),"
        },
        {
          "line": 23,
          "text": "        .sample(sample),.sample_ce(sample_ce),.clipped_samples(clipped_samples)"
        },
        {
          "line": 24,
          "text": "    );"
        },
        {
          "line": 25,
          "text": "endmodule"
        }
      ]
    },
    "sim/system_main.cpp": {
      "sha256": "ac8fc5de33ba606dca879ecaa337e37d0cfee9f23c96125f4e2781ed7b776202",
      "lines": [
        {
          "line": 95,
          "text": "    audio_events<<\"tick,frame,kind,address,data\\n\";"
        },
        {
          "line": 96,
          "text": "    epoch_events<<\"tick,frame,raster_x,raster_y,address,iack,rw,uds_n,lds_n,data_out,data_in\\n\";"
        },
        {
          "line": 97,
          "text": "    std::ofstream sound_bus,pcm_stream;"
        },
        {
          "line": 98,
          "text": "    if(dac_probe) {"
        },
        {
          "line": 99,
          "text": "        sound_bus.open(output/\"sound_bus_events.csv\");"
        },
        {
          "line": 100,
          "text": "        sound_bus<<\"tick,frame,kind,address,data,m1_n\\n\";"
        },
        {
          "line": 101,
          "text": "        pcm_stream.open(output/\"audio.pcm\",std::ios::binary);"
        },
        {
          "line": 102,
          "text": "    }"
        },
        {
          "line": 103,
          "text": "    events<<\"tick,address,transaction,iack,rw,uds_n,lds_n,data_out,data_in\\n\";"
        },
        {
          "line": 104,
          "text": "    summary<<\"frame,main_address,sound_address,main_transactions,work_writes,strip_writes,mcu_transactions,irq1_acks,irq2_acks,unmapped,pixels,duplicates,worst_line_cycles,completed_lines,deadline_misses,row_overflows\\n\";"
        },
        {
          "line": 148,
          "text": "        <<\" device_writes=\"<<device.writes<<\" refreshes=\"<<device.refreshes<<std::endl;"
        },
        {
          "line": 149,
          "text": "    top.reset=0;"
        },
        {
          "line": 150,
          "text": "    std::vector<uint8_t> rgb(256*224*3),seen(256*224);"
        },
        {
          "line": 151,
          "text": "    unsigned frame=0,pixels=0,duplicates=0,sampled=0,extra_samples=0;"
        },
        {
          "line": 152,
          "text": "    uint32_t previous=0;"
        },
        {
          "line": 153,
          "text": "    bool capture_ok=true;"
