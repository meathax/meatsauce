# Owned dependency-preserving sys QIP; only MCP100k source is redirected.
set penguin_owned_rtl_root [file normalize $::quartus(qip_path)]
set penguin_sys_root [file normalize [file join $penguin_owned_rtl_root .. sys]]
set_global_assignment -name QIP_FILE [file join $penguin_sys_root [format {pll_q%s.qip} [regexp -inline {[0-9]+} $quartus(version)]]]
set_global_assignment -name VERILOG_FILE       [file join $penguin_sys_root sys_top.v ]
set_global_assignment -name SDC_FILE           [file join $penguin_sys_root sys_top.sdc ]
set_global_assignment -name VHDL_FILE          [file join $penguin_owned_rtl_root penguin_platform_ascal.vhd ]
set_global_assignment -name VHDL_FILE          [file join $penguin_sys_root pll_hdmi_adj.vhd ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $penguin_sys_root math.sv ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $penguin_sys_root hq2x.sv ]
set_global_assignment -name VERILOG_FILE       [file join $penguin_sys_root scandoubler.v ]
set_global_assignment -name VERILOG_FILE       [file join $penguin_sys_root scanlines.v ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $penguin_sys_root shadowmask.sv ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $penguin_sys_root video_cleaner.sv ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $penguin_sys_root gamma_corr.sv ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $penguin_sys_root video_mixer.sv ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $penguin_sys_root video_freak.sv ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $penguin_sys_root video_freezer.sv ]
set_global_assignment -name VERILOG_FILE       [file join $penguin_owned_rtl_root penguin_platform_arcade_sources.v ]
set_global_assignment -name VERILOG_FILE       [file join $penguin_sys_root osd.v ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $penguin_sys_root vga_out.sv ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $penguin_sys_root yc_out.sv ]
set_global_assignment -name VERILOG_FILE       [file join $penguin_sys_root i2c.v ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $penguin_sys_root alsa.sv ]
set_global_assignment -name VERILOG_FILE       [file join $penguin_sys_root i2s.v ]
set_global_assignment -name VERILOG_FILE       [file join $penguin_sys_root spdif.v ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $penguin_sys_root audio_out.sv ]
set_global_assignment -name VERILOG_FILE       [file join $penguin_sys_root iir_filter.v ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $penguin_sys_root ltc2308.sv ]
set_global_assignment -name VERILOG_FILE       [file join $penguin_sys_root sigma_delta_dac.v ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $penguin_sys_root mt32pi.sv ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $penguin_owned_rtl_root penguin_platform_mcp23009.sv ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $penguin_sys_root f2sdram_safe_terminator.sv ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $penguin_sys_root ddr_svc.sv ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $penguin_sys_root sysmem.sv ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $penguin_sys_root sd_card.sv ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $penguin_owned_rtl_root penguin_platform_hps_io.sv ]
set_global_assignment -name SOURCE_FILE        [file join $penguin_sys_root emu_ports.vh ]
