# Mad Motor emu wrapper and existing game/board source closure.
set mm_src_root [file dirname [file normalize [info script]]]
# Loaded after sys/sys.tcl's platform roots; guarded hard-HPS port affinity.
set_global_assignment -name SDC_FILE [file join $mm_src_root constraints/madmotor_hps_affinity.sdc]
# Define the SDRAM boundary clock after the guarded hard-HPS inventory.
set_global_assignment -name SDC_FILE [file join $mm_src_root constraints/madmotor_sdram.sdc]
