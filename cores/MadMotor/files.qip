# Host/game initialization tables consumed by $readmem*. These are source
# data, not additional game-ROM upload indices.
set_global_assignment -name SOURCE_FILE [file join $mm_src_root microrom.mem]
set_global_assignment -name SOURCE_FILE [file join $mm_src_root nanorom.mem]
set_global_assignment -name SOURCE_FILE [file join $mm_src_root madmotor_lofi_coeff.hex]

foreach mm_rtl [glob -nocomplain [file join $mm_src_root donors/Arcade-Deco16_Mister/rtl/jt12/*.v]] {
    set_global_assignment -name VERILOG_FILE $mm_rtl
}
foreach mm_rtl [glob -nocomplain [file join $mm_src_root donors/Arcade-Deco16_Mister/rtl/jt49/*.v]] {
    set_global_assignment -name VERILOG_FILE $mm_rtl
}
foreach mm_rtl [glob -nocomplain [file join $mm_src_root donors/Arcade-Deco16_Mister/rtl/ikaopm/*.v]] {
    set_global_assignment -name VERILOG_FILE $mm_rtl
}
foreach mm_rtl [glob -nocomplain [file join $mm_src_root donors/Arcade-Deco16_Mister/rtl/jtframe/sdram/jtframe_sdram64*.v]] {
    # The private top preserves the tested donor except its input capture edge.
    if {[file tail $mm_rtl] ne "jtframe_sdram64.v"} {
        set_global_assignment -name VERILOG_FILE $mm_rtl
    }
}
set_global_assignment -name VERILOG_FILE [file join $mm_src_root donors/Arcade-Deco16_Mister/rtl/jtframe/ram/jtframe_prom.v]
set_global_assignment -name VERILOG_FILE [file join $mm_src_root donors/Arcade-ActFancer_MiSTer/jtframe/hdl/video/jtframe_vtimer.v]
