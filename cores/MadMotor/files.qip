# The Mad Motor sound CPU is kept as native VHDL in Quartus. The GHDL-created
# huc6280_ce.v is only a temporary host-simulation source.
set_global_assignment -name VHDL_FILE [file join $mm_src_root rtl/audio/huc6280/HUC6280_PKG.vhd]
set_global_assignment -name VHDL_FILE [file join $mm_src_root rtl/audio/huc6280/AddSubBCD.vhd]
