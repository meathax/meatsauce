foreach mm_rtl [glob -nocomplain [file join $mm_src_root donors/TUMBLE-jt6295-b803636/*.v]] {
    set_global_assignment -name VERILOG_FILE $mm_rtl
}

set_global_assignment -name SDC_FILE [file join $mm_src_root constraints/madmotor_scaler_read_cdc.sdc]
