# Source-bound held-data CDC and dedicated reset-boundary constraints.
# See docs/USER_CDC_BUDGET_20261022.md. No clock groups or multicycle.
proc mm_cdc_regs {pattern count} {
    set result [get_registers $pattern]
    if {[get_collection_size $result] != $count} {error "CDC endpoint inventory changed: $pattern"}
    return $result
}
proc mm_cdc_bus_members {names stem width} {
    set bits [dict create]
    set seen [dict create]
    foreach name $names {
        if {![regexp {(?:^|[|])([A-Za-z_][A-Za-z0-9_]*)\[([0-9]+)\](~DUPLICATE[0-9]*)?$} $name match found bit replica]} {error "Unexpected CDC bus register: $name"}
        if {$found ne $stem || $bit < 0 || $bit >= $width} {error "CDC bus member outside $stem/$width: $name"}
        if {[dict exists $seen $name]} {error "Repeated physical CDC bus member: $name"}
        dict set seen $name 1
        dict incr bits $bit
        if {[dict get $bits $bit] > 4} {error "Unexpected CDC bus replica count: $name"}
    }
    for {set bit 0} {$bit < $width} {incr bit} {
        if {![dict exists $bits $bit]} {error "Missing logical CDC bus bit: $stem\[$bit\]"}
    }
    return [dict size $seen]
}
proc mm_cdc_bus {pattern stem width} {
    set regs [get_registers $pattern]
    set names {}
    foreach_in_collection node $regs {lappend names [get_register_info -name $node]}
    mm_cdc_bus_members $names $stem $width
    return $regs
}
proc mm_cdc_toggle {source destination} {
    set launches [get_registers $source]
    set target [mm_cdc_regs $destination 1]
    # Physical copies of a preserved toggle can be generated by the fitter.
    if {[get_collection_size $launches] < 1 || [get_collection_size $launches] > 4} {error "CDC toggle replicas changed: $source"}
    set_false_path -from $launches -to $target
}
set mm_cdc_core [get_clocks {*platform_pll*PLL_OUTPUT_COUNTER*divclk}]
set mm_cdc_audio [get_clocks {pll_audio*PLL_OUTPUT_COUNTER*divclk}]
if {[get_collection_size $mm_cdc_core] != 1 || [get_collection_size $mm_cdc_audio] != 1} {error "CDC roots changed"}
set mm_cdc_src_period [get_clock_info -period $mm_cdc_core]
set mm_cdc_dst_period [get_clock_info -period $mm_cdc_audio]
if {abs($mm_cdc_src_period-1000.0/60)>0.001 || abs($mm_cdc_dst_period-40.682)>0.02} {error "CDC clock profile changed"}
# Earliest capture is two destination periods after launching a held word.
# Earliest replacement is two source periods after receiver acknowledgement.
# A one-period budget on each side retains at least a full protocol period.
# Q17 max/min constraints INCLUDE the launch/capture clock-latency terms.
set mm_audio_held [mm_cdc_regs {*|audio_transfer|held_payload[*]} 32]
set mm_audio_dst [mm_cdc_regs {*|audio_transfer|dst_left[*] *|audio_transfer|dst_right[*]} 32]
# The fitted enable bit can be replicated. Require all30 logical bits and
# include every physical copy under the unchanged held-bus timing budget.
set mm_palette_held [mm_cdc_bus {*palette_transfer|held_context[*]} held_context 30]
set mm_palette_dst [mm_cdc_regs {*palette_transfer|palette_addr[*] *palette_transfer|palette_req *palette_transfer|beat_count[*] *palette_transfer|burst_busy} 38]
# Optional constant bits are AUDIO_S=1 and AUDIO_MIX=0 in MadMotor.sv.
# Unused169-bit-rate MSB and tap coefficients[6:3] are source-proven below.
# Require every dynamic bit and constrain every physical replica as well.
proc mm_config_bus {pattern} {
    set regs [get_registers $pattern]
    set bits [dict create]
    foreach_in_collection reg $regs {
        set name [get_register_info -name $reg]
        if {![regexp {\[([0-9]+)\](~DUPLICATE.*)?$} $name match bit]} {error "Unexpected config register $name"}
        if {$bit<0 || $bit>=179} {error "Config bit outside179"}
        dict incr bits $bit
        if {[dict get $bits $bit]>4} {error "Unexpected config replicas"}
    }
    for {set bit 0} {$bit<179} {incr bit} {
        if {$bit ni {0 170 171 76 77 78 79 84 85 86 87 92 93 94 95 168} && ![dict exists $bits $bit]} {error "Missing dynamic config bit$bit"}
    }
    return $regs
}
set mm_config_held [mm_config_bus {*audio_config_transfer|held_payload*}]
set mm_config_dst [mm_config_bus {*audio_config_transfer|dst_data*}]
foreach {held receivers} [list $mm_audio_held $mm_audio_dst $mm_palette_held $mm_palette_dst $mm_config_held $mm_config_dst] {
    set_max_delay -from $held -to $receivers $mm_cdc_dst_period
    set_min_delay -from $held -to $receivers [expr {-$mm_cdc_src_period}]
}
mm_cdc_toggle {*|audio_transfer|request_toggle*} {*|audio_transfer|request_sync[0]}
mm_cdc_toggle {*|audio_transfer|acknowledge_toggle*} {*|audio_transfer|acknowledge_sync[0]}
mm_cdc_toggle {*palette_transfer|response_toggle*} {*palette_transfer|response_sync[0]}
mm_cdc_toggle {*palette_transfer|request_toggle*} {*palette_transfer|request_sync[0]}
mm_cdc_toggle {*audio_config_transfer|request_toggle*} {*audio_config_transfer|request_sync[0]}
mm_cdc_toggle {*audio_config_transfer|acknowledge_toggle*} {*audio_config_transfer|acknowledge_sync[0]}
# Output configuration buses use the same width-independent held-word protocol.
# Native observation must enumerate all physical fanout (including DSP copies).
set mm_video_clock [get_clocks {pll_hdmi|pll_hdmi_inst|altera_pll_i|*[0].*|divclk}]
if {[get_collection_size $mm_video_clock]!=1} {error "Scaler clock inventory changed"}
set mm_video_bridges [list \
    framebuffer_video_config_transfer 77 $mm_cdc_core $mm_video_clock \
    hdmi_osd|video_config_transfer 132 $mm_cdc_core $mm_video_clock \
    vga_osd|video_config_transfer 132 $mm_cdc_core $mm_cdc_core \
    scaler_output_video_config_transfer 163 $mm_cdc_core $mm_video_clock \
    HDMI_shadowmask|settings_video_config_transfer 13 $mm_cdc_core $mm_video_clock \
    scaler_input_video_config_transfer 32 $mm_cdc_core $mm_video_clock \
    scaler_feedback_video_config_transfer 28 $mm_video_clock $mm_cdc_core]
foreach {instance width source_clock destination_clock} $mm_video_bridges {
    set held [get_registers "*$instance|held_payload*"]
    set received [get_registers "*$instance|dst_data*"]
    foreach regs [list $held $received] {
        if {[get_collection_size $regs]<1 || [get_collection_size $regs]>4*$width} {error "Missing/unbounded video config inventory: $instance"}
    }
    set_max_delay -from $held -to $received [get_clock_info -period $destination_clock]
    set_min_delay -from $held -to $received [expr {-[get_clock_info -period $source_clock]}]
    mm_cdc_toggle "*$instance|request_toggle*" "*$instance|request_sync\[0\]"
    mm_cdc_toggle "*$instance|acknowledge_toggle*" "*$instance|acknowledge_sync\[0\]"
}
# Only asynchronous control pins of dedicated two-stage reset boundaries.
# Their D paths, interstage paths and released reset consumers remain timed.
set mm_reset_pins [get_pins -compatibility_mode {
    *|platform_reset|release_pipe[*]|clrn
    *|audio_transfer|source_reset|release_pipe[*]|clrn
    *|audio_transfer|destination_reset|release_pipe[*]|clrn
    *|game_reset_release|release_pipe[*]|clrn
    *audio_config_transfer|source_reset|release_pipe[*]|clrn
    *audio_config_transfer|destination_reset|release_pipe[*]|clrn
    *framework_audio_reset|release_pipe[*]|clrn
    ascal|i_reset_meta|clrn ascal|i_reset_na|clrn
    ascal|o_reset_meta|clrn ascal|o_reset_na|clrn
    ascal|avl_reset_meta|clrn ascal|avl_reset_na|clrn
    framebuffer_video_config_transfer|source_reset|release_pipe[*]|clrn
    framebuffer_video_config_transfer|destination_reset|release_pipe[*]|clrn
    hdmi_osd|video_config_transfer|source_reset|release_pipe[*]|clrn
    hdmi_osd|video_config_transfer|destination_reset|release_pipe[*]|clrn
    vga_osd|video_config_transfer|source_reset|release_pipe[*]|clrn
    vga_osd|video_config_transfer|destination_reset|release_pipe[*]|clrn
    scaler_output_video_config_transfer|source_reset|release_pipe[*]|clrn
    scaler_output_video_config_transfer|destination_reset|release_pipe[*]|clrn
    HDMI_shadowmask|settings_video_config_transfer|source_reset|release_pipe[*]|clrn
    HDMI_shadowmask|settings_video_config_transfer|destination_reset|release_pipe[*]|clrn
    scaler_input_video_config_transfer|source_reset|release_pipe[*]|clrn
    scaler_input_video_config_transfer|destination_reset|release_pipe[*]|clrn
    scaler_feedback_video_config_transfer|source_reset|release_pipe[*]|clrn
    scaler_feedback_video_config_transfer|destination_reset|release_pipe[*]|clrn
    *pll_config_reset_release|release_pipe[*]|clrn
    *|ram1_reset_0|clrn *|ram1_reset_1|clrn
}]
if {[get_collection_size $mm_reset_pins] != 52} {error "Reset synchronizer control-pin inventory changed"}
set_false_path -to $mm_reset_pins
# fb_vbl is the existing first sample of an HDMI level; the actual rotation
# consumer retains two further preserved same-root stages. Cut only that
# first capture; its downstream D/interstage paths stay full-rate timed.
set mm_fb_vbl_source [mm_cdc_regs {*ascal|o_vbl} 1]
set mm_fb_vbl_first [mm_cdc_regs {fb_vbl} 1]
set_false_path -from $mm_fb_vbl_source -to $mm_fb_vbl_first
