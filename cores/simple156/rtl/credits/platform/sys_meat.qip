# Generated from pinned sys/sys.qip; only osd.v is substituted.
set simple156_meat_sys_root [file normalize [file join $::quartus(qip_path) .. .. .. sys]]/
set_global_assignment -name QIP_FILE           [join [list $simple156_meat_sys_root pll_q [regexp -inline {[0-9]+} $quartus(version)] .qip] {}]
set_global_assignment -name VERILOG_FILE       [file join $simple156_meat_sys_root sys_top.v ]
set_global_assignment -name SDC_FILE           [file join $simple156_meat_sys_root sys_top.sdc ]
set_global_assignment -name VHDL_FILE          [file join $simple156_meat_sys_root ascal.vhd ]
set_global_assignment -name VHDL_FILE          [file join $simple156_meat_sys_root pll_hdmi_adj.vhd ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $simple156_meat_sys_root math.sv ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $simple156_meat_sys_root hq2x.sv ]
set_global_assignment -name VERILOG_FILE       [file join $simple156_meat_sys_root scandoubler.v ]
set_global_assignment -name VERILOG_FILE       [file join $simple156_meat_sys_root scanlines.v ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $simple156_meat_sys_root shadowmask.sv ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $simple156_meat_sys_root video_cleaner.sv ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $simple156_meat_sys_root gamma_corr.sv ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $simple156_meat_sys_root video_mixer.sv ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $simple156_meat_sys_root video_freak.sv ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $simple156_meat_sys_root video_freezer.sv ]
set_global_assignment -name VERILOG_FILE       [file join $simple156_meat_sys_root arcade_video.v ]
set_global_assignment -name VERILOG_FILE       [file join $::quartus(qip_path) .. rtl meat_osd.v ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $simple156_meat_sys_root vga_out.sv ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $simple156_meat_sys_root yc_out.sv ]
set_global_assignment -name VERILOG_FILE       [file join $simple156_meat_sys_root i2c.v ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $simple156_meat_sys_root alsa.sv ]
set_global_assignment -name VERILOG_FILE       [file join $simple156_meat_sys_root i2s.v ]
set_global_assignment -name VERILOG_FILE       [file join $simple156_meat_sys_root spdif.v ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $simple156_meat_sys_root audio_out.sv ]
set_global_assignment -name VERILOG_FILE       [file join $simple156_meat_sys_root iir_filter.v ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $simple156_meat_sys_root ltc2308.sv ]
set_global_assignment -name VERILOG_FILE       [file join $simple156_meat_sys_root sigma_delta_dac.v ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $simple156_meat_sys_root mt32pi.sv ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $simple156_meat_sys_root mcp23009.sv ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $simple156_meat_sys_root f2sdram_safe_terminator.sv ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $simple156_meat_sys_root ddr_svc.sv ]
