orgs","repos_url":"https://api.github.com/users/galibert/repos","events_url":"https://api.github.com/users/galibert/events{/privacy}","received_events_url":"https://api.github.com/users/galibert/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"galibert","id":9249521,"node_id":"MDQ6VXNlcjkyNDk1MjE=","avatar_url":"https://avatars.githubusercontent.com/u/9249521?v=4","gravatar_id":"","url":"https://api.github.com/users/galibert","html_url":"https://github.com/galibert","followers_url":"https://api.github.com/users/galibert/followers","following_url":"https://api.github.com/users/galibert/following{/other_user}","gists_url":"https://api.github.com/users/galibert/gists{/gist_id}","starred_url":"https://api.github.com/users/galibert/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/galibert/subscriptions","organizations_url":"https://api.github.com/users/galibert/orgs","repos_url":"https://api.github.com/users/galibert/repos","events_url":"https://api.github.com/users/galibert/events{/privacy}","received_events_url":"https://api.github.com/users/galibert/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"f3bd2d2a56c36b567354e44f1db82c63ae49ea22","url":"https://api.github.com/repos/mamedev/mame/commits/f3bd2d2a56c36b567354e44f1db82c63ae49ea22","html_url":"https://github.com/mamedev/mame/commit/f3bd2d2a56c36b567354e44f1db82c63ae49ea22"}]},{"sha":"f4f6f34f2a858df7f77213f034965ec5a6c59e1c","node_id":"C_kwDOANo_SNoAKGY0ZjZmMzRmMmE4NThkZjdmNzcyMTNmMDM0OTY1ZWM1YTZjNTllMWM","commit":{"author":{"name":"Vas Crabb","email":"vas@vastheman.com","date":"2026-06-01T21:55:03Z"},"committer":{"name":"Vas Crabb","email":"vas@vastheman.com","date":"2026-06-01T23:19:58Z"},"message":"-emu/output.cpp: Updated API:\n\n* Added a lightweight output proxy class for interacting with outputs\n  from outside a device context.  If an output doesn't exist, it stores\n  a local value.  Note that this means layouts cannot create outputs,\n  e.g. to communicate between views.  Outputs are only created by output\n  finders when resolving objects.\n* Made output finders participate in object resolution in the device\n  lifecycle.  They no longer need to be manually resolved.  Conversely,\n  you can't avoid creating outputs by not explicitly resolving them.\n* Added some validation rules for output names.\n* Got rid of the deprecated get_value/set_value.  The Lua versions will\n  stick around a bit longer to give people time to migrate.\n* Some other internal API changes in preparation for per-device outputs.\n\n-emu, util: Replaced remaining uses of std::enable_if and void_t with\n C++20 constraints and concepts.  This makes some lines considerably\n shorter, to the point that some of them may even fit on your screen.\n\n-util/strformat.h: Fixed formatting bool values with numeric\n conversions.\n\n-emu/devfind.cpp: Made object finders and similar things explicitly\n non-copyable.  Copying them never behaved intuitively.","tree":{"sha":"74e77e2f1650772fc6ec189d987accfb7083aee6","url":"https://api.github.com/repos/mamedev/mame/git/trees/74e77e2f1650772fc6ec189d987accfb7083aee6"},"url":"https://api.github.com/repos/mamedev/mame/git/commits/f4f6f34f2a858df7f77213f034965ec5a6c59e1c","comment_count":6,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/mamedev/mame/commits/f4f6f34f2a858df7f77213f034965ec5a6c59e1c","html_url":"https://github.com/mamedev/mame/commit/f4f6f34f2a858df7f77213f034965ec5a6c59e1c","comments_url":"https://api.github.com/repos/mamedev/mame/commits/f4f6f34f2a858df7f77213f034965ec5a6c59e1c/comments","author":{"login":"cuavas","id":9678431,"node_id":"MDQ6VXNlcjk2Nzg0MzE=","avatar_url":"https://avatars.githubusercontent.com/u/9678431?v=4","gravatar_id":"","url":"https://api.github.com/users/cuavas","html_url":"https://github.com/cuavas","followers_ur