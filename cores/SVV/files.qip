# SSV MiSTer project file list
set_global_assignment -name QIP_FILE sys/sys.qip
set_global_assignment -name SDC_FILE Arcade-SSV.sdc

set_global_assignment -name SYSTEMVERILOG_FILE Arcade-SSV.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ssv_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ssv_host_guard.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ssv_video_mode_guard.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ssv_irq.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ssv_video_timing.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/io/ssv_input_ports.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/io/ssv_mahjong_matrix.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/io/ssv_upd4701.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/io/ssv_upd7001.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/io/ssv_adc0809.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/io/ssv_93c46_16.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/audio/ssv_srmp7_bank.sv
# rtl/video/ssv_sprite_decode.sv is intentionally absent: nothing in the build
# instantiates it. Its only consumer was the legacy rtl/video/ssv_sprite_renderer.sv,
# which is already out of the file list (the release uses the cached renderer).
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/ssv_gfx_row_decode.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/ssv_st0020_ctrl.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/ssv_gfx_row_fetch.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/ssv_palette_ram.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/ssv_line_buffer4.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/ssv_mlab88_sdp.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/ssv_bg_renderer.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/ssv_mlab240_sdp.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/ssv_cached_sprite_renderer.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/audio/ssv_mlab32_sdp.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/audio/ssv_es5506_regs.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/audio/ssv_es5506_voice.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/audio/ssv_audio_cdc.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/debug/ssv_audio_debug_overlay.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ssv_core.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ssv_scandoubler.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ssv_pixel_retime.sv
# Vendored from JimmyStones/Hiscores_MiSTer (GPLv2+). One marked local change:
# dpram_hs picks its storage style from array depth, see the comment there.
set_global_assignment -name VERILOG_FILE rtl/hiscore.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/common/s32_big_dpram.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cpu/v60/s32_v60.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cpu/v60/s32_v60_bus.sv

# ST010 (NEC uPD96050) DSP, needed by Drift Out '94, Storm Blade and Twin
# Eagle II. The universal core instantiates the wrapper and program fetcher
# unconditionally and gates runtime activity only through cfg.has_st010, so
# these files are mandatory in the one shared RBF.
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cpu/upd96050/upd96050.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cpu/upd96050/upd96050_st010.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cpu/upd96050/ssv_st010_prg_fetch.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/mem/sdram.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/mem/ssv_rom_loader.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/mem/ssv_ddr_rom_loader.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/mem/ssv_nvram_bridge.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/mem/ssv_hs_extram.sv
set_global_assignment -name QIP_FILE rtl/pll/pll.qip
