set_global_assignment -name QIP_FILE rtl/pll.qip
# The generated CPU PLL QIP contains a self-referential QIP_FILE entry that
# Quartus 17.0 rejects as infinite recursion.  Its generated Verilog wrapper
# is the actual synthesis input; retain the QIP/CMP/SOPCINFO files as provenance
# but include the wrapper directly in this project manifest.
set_global_assignment -name VERILOG_FILE rtl/irobot_cpu_pll.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/irobot_rom_router.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/io/irobot_nvram_write_cdc.sv
