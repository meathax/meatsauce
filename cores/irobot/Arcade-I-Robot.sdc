derive_pll_clocks
derive_clock_uncertainty

# The SP-251 CPU and video oscillators, the HDMI/audio output domains and the
# framework reference clocks are independent transfers.  The vendored
# wildcard group matches no main PLL clock in this hierarchy, so name every
# actual clock here.  CDC boundaries are explicit in irobot_board and the
# framework owns the HDMI/audio crossings.
set_clock_groups -exclusive \
    -group [get_clocks {emu|pll_i|pll_inst|altera_pll_i|general[0].gpll~PLL_OUTPUT_COUNTER|divclk}] \
    -group [get_clocks {emu|cpu_pll_i|altera_pll_i|general[0].gpll~PLL_OUTPUT_COUNTER|divclk}] \
    -group [get_clocks {pll_hdmi|pll_hdmi_inst|altera_pll_i|cyclonev_pll|counter[0].output_counter|divclk}] \
    -group [get_clocks {pll_audio|pll_audio_inst|altera_pll_i|general[0].gpll~PLL_OUTPUT_COUNTER|divclk}] \
    -group [get_clocks {FPGA_CLK1_50}] \
    -group [get_clocks {FPGA_CLK2_50}] \
    -group [get_clocks {FPGA_CLK3_50}] \
    -group [get_clocks {spi_sck}] \
    -group [get_clocks {hdmi_sck}] \
    -group [get_clocks {sysmem|fpga_interfaces|clocks_resets|h2f_user0_clk}]

# E/Q are the 1.512 MHz quadrature clocks generated by the CPU phase divider.
# Q leads E by two master ticks; board reset does not stop the divider.
create_generated_clock -name irobot_q_clk \
    -source [get_pins {emu|cpu_pll_i|altera_pll_i|outclk_wire[0]~CLKENA0|outclk}] \
    -edges {1 9 17} \
    [get_keepers {*|phases|q}]
create_generated_clock -name irobot_e_clk \
    -source [get_pins {emu|cpu_pll_i|altera_pll_i|outclk_wire[0]~CLKENA0|outclk}] \
    -edges {5 13 21} \
    [get_keepers {*|phases|e}]
