public_flat_rd -module "vr0_gpu" -var "queue_rear"
public_flat_rd -module "vr0_gpu" -var "control"
public_flat_rd -module "vr0_gpu" -var "burst_valid"
public_flat_rd -module "vr0_gpu" -var "burst_ready"
public_flat_rd -module "vr0_gpu" -var "burst_done"
public_flat_rd -module "vr0_gpu" -var "burst_write"
