set_global_assignment -name VERILOG_FILE       [file join $cs_sys_path scandoubler.v ]
set_global_assignment -name VERILOG_FILE       [file join $cs_sys_path scanlines.v ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $cs_sys_path shadowmask.sv ]
