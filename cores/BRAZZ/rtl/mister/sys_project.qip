set_global_assignment -name SYSTEMVERILOG_FILE [file join $cs_sys_path f2sdram_safe_terminator.sv ]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $cs_sys_path ddr_svc.sv ]
