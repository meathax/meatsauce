set_global_assignment -name VERILOG_MACRO "JTFRAME_ROTATE=1"
set_global_assignment -name VERILOG_MACRO "JTFRAME_SDRAM96=1"
set_global_assignment -name VERILOG_MACRO "JTFRAME_SIGNED_SND=1"
set_global_assignment -name VERILOG_MACRO "JTFRAME_STEREO=1"
set_global_assignment -name VERILOG_MACRO "JTFRAME_TIMESTAMP=1790866065"
set_global_assignment -name VERILOG_MACRO "JTFRAME_USER_ROTATION=1"
set_global_assignment -name VERILOG_MACRO "JTFRAME_VERTICAL=1"
set_global_assignment -name VERILOG_MACRO "JTFRAME_WIDTH=9'd288"
set_global_assignment -name VERILOG_MACRO "MISTER=1"
set_global_assignment -name VERILOG_MACRO "MISTER_FB="
set_global_assignment -name VERILOG_MACRO "PCM_START='h240000"
set_global_assignment -name VERILOG_MACRO "SEPARATOR=-;"
set_global_assignment -name VERILOG_MACRO "TARGET=mister"
set_global_assignment -name VERILOG_MACRO "VIOSTORM="
set_global_assignment -name TIMEQUEST_REPORT_SCRIPT tools/sta_paths.tcl
set_global_assignment -name SEED 1
set_global_assignment -name ON_CHIP_BITSTREAM_DECOMPRESSION ON

set_global_assignment -name VERILOG_MACRO "JTFRAME_OSD_TEST=1"
set_global_assignment -name VERILOG_MACRO "MISTER_DISABLE_YC=1"
set_global_assignment -name VERILOG_MACRO "MISTER_DISABLE_ALSA=1"

# C4 read pipeline and delayed SDRAM forwarding contract.
set_global_assignment -name VERILOG_MACRO "JTFRAME_PHASED_READCAPTURE=1"
set_global_assignment -name VERILOG_MACRO "JTFRAME_DELAYED_SDRAM_FORWARD=1"
set_global_assignment -name NUM_PARALLEL_PROCESSORS 4
set_global_assignment -name GENERATE_RBF_FILE OFF

# Isolated phased-profile placement hypothesis; Root review/native verification required.
set_instance_assignment -name GLOBAL_SIGNAL "GLOBAL CLOCK" -to emu:emu|pll:pll|pll_0002:pll_inst|altera_pll:altera_pll_i|outclk_wire[3]
set_global_assignment -name SDC_FILE hdl/metamorphic_selected_145_interface_r9.sdc

# Final video I/O placement: preserve all external timing requirements.
set_global_assignment -name OPTIMIZE_IOC_REGISTER_PLACEMENT_FOR_TIMING ON
set_instance_assignment -name FAST_OUTPUT_ENABLE_REGISTER ON -to VGA_R[*]
set_instance_assignment -name FAST_OUTPUT_ENABLE_REGISTER ON -to VGA_G[*]
set_instance_assignment -name FAST_OUTPUT_ENABLE_REGISTER ON -to VGA_B[*]
set_instance_assignment -name FAST_OUTPUT_ENABLE_REGISTER ON -to VGA_HS
set_instance_assignment -name FAST_OUTPUT_ENABLE_REGISTER ON -to VGA_VS
set_instance_assignment -name SLEW_RATE 1 -to HDMI_TX_D[*]
set_instance_assignment -name SLEW_RATE 1 -to HDMI_TX_HS
set_instance_assignment -name SLEW_RATE 1 -to HDMI_TX_VS
set_instance_assignment -name SLEW_RATE 1 -to HDMI_TX_DE
set_instance_assignment -name SLEW_RATE 1 -to VGA_R[*]
set_instance_assignment -name SLEW_RATE 1 -to VGA_G[*]
set_instance_assignment -name SLEW_RATE 1 -to VGA_B[*]
set_instance_assignment -name SLEW_RATE 1 -to VGA_HS
set_instance_assignment -name SLEW_RATE 1 -to VGA_VS
set_instance_assignment -name SLEW_RATE 1 -to SDIO_*
set_instance_assignment -name SLEW_RATE 1 -to LED_POWER
set_instance_assignment -name SLEW_RATE 1 -to LED_HDD

# Delay both edges of the forwarded HDMI clock using the supported I/O delay.
set_instance_assignment -name OUTPUT_BUFFER_DELAY_CONTROL "Both Edges" -to HDMI_TX_CLK
set_instance_assignment -name OUTPUT_BUFFER_DELAY 150 -to HDMI_TX_CLK
# Analog pin registers and forwarded clock are local to the VGA GPIO region.
set_instance_assignment -name FAST_OUTPUT_REGISTER ON -to SDIO_CLK
set_instance_assignment -name FAST_OUTPUT_ENABLE_REGISTER ON -to SDIO_CLK
set_instance_assignment -name FAST_OUTPUT_REGISTER ON -to SDIO_CMD
set_instance_assignment -name FAST_OUTPUT_ENABLE_REGISTER ON -to SDIO_CMD
set_instance_assignment -name FAST_OUTPUT_REGISTER ON -to SDIO_DAT[*]
set_instance_assignment -name FAST_OUTPUT_ENABLE_REGISTER ON -to SDIO_DAT[*]
set_instance_assignment -name FAST_OUTPUT_REGISTER ON -to LED_POWER
set_instance_assignment -name FAST_OUTPUT_ENABLE_REGISTER ON -to LED_POWER
set_instance_assignment -name FAST_OUTPUT_REGISTER ON -to LED_HDD
set_instance_assignment -name FAST_OUTPUT_ENABLE_REGISTER ON -to LED_HDD

# Pin-only timing candidate; preserve original clock delay and receiver budgets.
set_instance_assignment -name CURRENT_STRENGTH_NEW 16MA -to HDMI_TX_D[*]
set_instance_assignment -name CURRENT_STRENGTH_NEW 16MA -to HDMI_TX_DE
set_instance_assignment -name CURRENT_STRENGTH_NEW 16MA -to HDMI_TX_HS
set_instance_assignment -name CURRENT_STRENGTH_NEW 16MA -to HDMI_TX_VS

# Explicit forwarded HDMI clock electrical settings; keep receiver constraints unchanged.
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to HDMI_TX_CLK
set_instance_assignment -name SLEW_RATE 1 -to HDMI_TX_CLK
