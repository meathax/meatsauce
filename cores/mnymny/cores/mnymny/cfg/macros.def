CORENAME=JTMNYMNY
JTFRAME_RATE=60.61

JTFRAME_PLL=jtframe_pll6144
JTFRAME_PXLCLK=6

JTFRAME_JOY_DURL
JTFRAME_BUTTONS=1

# Stock MiSTer template: OSD_COLOR=3'd4 (red). JTFRAME uses two bits
# per RGB channel; 6'h10 maps the template's single red background bit.
JTFRAME_OSDCOLOR=(6'h10)
JTFRAME_OSD_NOLOGO

# Keep in the common scope: MRA generation must also see DDR staging.
JTFRAME_MR_DDRLOAD

# Video
JTFRAME_VERTICAL
JTFRAME_ROTATE
JTFRAME_WIDTH=256
JTFRAME_HEIGHT=224
JTFRAME_COLORW=8

# ROM layout (download order)
JTFRAME_BA1_START=0x0C000
JTFRAME_BA2_START=0x14000
JTFRAME_PROM_START=0x1C000

SPEECH_START=0x10000
JTFRAME_HEADER=8
JTFRAME_IOCTL_RD=2048

# Standard MiSTer hiscore.v uses reserved HPS indices 3/4.
JTFRAME_HISCORE
# The action uses a free bit of the 64-bit HPS status register.
CORE_OSD=H7O8,Autosave Hiscores,Off,On;R[62],Credits;
