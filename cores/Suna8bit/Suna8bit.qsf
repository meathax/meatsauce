# Suna8bit MiSTer Quartus project. Keep source membership in files.qip.
set_global_assignment -name TOP_LEVEL_ENTITY sys_top
set_global_assignment -name LAST_QUARTUS_VERSION "17.0.2 Lite Edition"
set_global_assignment -name GENERATE_RBF_FILE ON
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS 8
set_global_assignment -name SAVE_DISK_SPACE OFF
set_global_assignment -name SMART_RECOMPILE ON
set_global_assignment -name COMPRESSION_MODE ON
# Enable the standard MiSTer DDRAM framebuffer conduit used by screen_rotate
# for the two MAME ROT90 vertical parents.
set_global_assignment -name VERILOG_MACRO "MISTER_FB=1"
# Use full Standard Fit effort for the HDMI scaler's timing-critical paths.
set_global_assignment -name FITTER_EFFORT "STANDARD FIT"
# 2026-09-07 (W20 ladder step 2): register duplication alone created 185
# duplicates elsewhere in ascal but left the o_hcpt[1] -> o_vcpt_pre3 path
# untouched (identical -0.005 ns). The path's 6.4 ns data delay at 148.5 MHz
# is routing-dominated, so raise router timing effort and allow register
# retiming across the counter's input register. Both are fitter-only.
set_global_assignment -name ROUTER_TIMING_OPTIMIZATION_LEVEL MAXIMUM
set_global_assignment -name PHYSICAL_SYNTHESIS_REGISTER_RETIMING ON
set_global_assignment -name PHYSICAL_SYNTHESIS_COMBO_LOGIC ON
# 2026-09-07 (W20): the only failing paths in the whole design are
# ascal:ascal|o_hcpt[1] -> ascal:ascal|o_vcpt_pre3[*] at the 148.5 MHz HDMI
# pixel clock (-0.005 ns, Slow -40C). One register fanning out to a counter
# family is the textbook case for fitter register duplication, which is a
# fitter-only option: no RTL, SDC, PLL or sys/ file changes. Turned ON.
set_global_assignment -name PHYSICAL_SYNTHESIS_REGISTER_DUPLICATION ON
# OPTIMIZATION_MODE "HIGH PERFORMANCE EFFORT" removed (2026-08-06): the
# first full compile after wiring in the four sound-chip cores
# (jtopl2/jt49/jt03x2, see suna8_sound_chips.sv) drove quartus_map's
# Timing-Driven Synthesis phase to >50 GB working set and had to be
# killed after ~100 min to avoid exhausting the host's 64 GB of RAM --
# a known Quartus 17 pathology where its most aggressive retiming/
# register-balancing effort explodes on designs that significantly
# exceed the target device's capacity, rather than failing cleanly.
# Falling back to Quartus's default (Balanced) mode is the minimal,
# reversible diagnostic step; if this fits and closes timing, keep it.
# If timing then fails, that's real evidence the design needs the
# RTL-level resource fix already flagged in this session's audit, not
# more effort-tuning.
set_global_assignment -name OPTIMIZATION_TECHNIQUE SPEED

source sys/sys.tcl
source sys/sys_analog.tcl
source files.qip
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top


set_global_assignment -name PRE_FLOW_SCRIPT_FILE "quartus_sh:sys/build_id.tcl"
