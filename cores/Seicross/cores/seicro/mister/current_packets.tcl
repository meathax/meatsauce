# Current mapped source identities; physical copies stay in full collections.
proc c04_resolve {pattern expected {first_stage 0}} {
    set found [get_registers $pattern]
    set canonical [list]
    foreach_in_collection r $found {
        set n [get_register_info -name $r]
        regsub {~DUPLICATE(_[0-9]+)?$} $n {} n
        regsub {~_Duplicate_[0-9]+$} $n {} n
        lappend canonical $n
    }
    if {[lsort -unique $canonical] ne [lsort $expected]} {error "Current source logical endpoint set changed $pattern"}
    if {$first_stage && [get_collection_size $found]!=1} {error "Asynchronous first-stage register cloned $pattern"}
    return $found
}
