CORENAME=JTBLKPAN

JTFRAME_BUTTONS=2
JTFRAME_COLORW=5
JTFRAME_STEREO
JTFRAME_WIDTH=256
JTFRAME_HEIGHT=224

# Same GX400 video timing as Nemesis: 18.432MHz/3 -> 6.144MHz pixel clock,
# 384x264 total, 60.606Hz (nemesis.cpp gx400_base_state::set_screen_raw_params,
# shared by gx400_state and salamand_state).
JTFRAME_PLL=jtframe_pll6144

JTFRAME_DIPBASE=16

# Required by the shared GX400 video donor, as in cores/nemesis/cfg/macros.def.
# The BRAM object buffers consume unfolded 16-bit addresses, not RAS/CAS bytes.
GX400_UNFOLD_DRAM_ADDR
SDRAM_FIX
K5291_NO_MUX

# MRA generation reads the global section even for MiSTer DDR staging.
JTFRAME_MR_DDRLOAD
BLKPAN_CPU_RECOVERY
BLKPAN_HISCORE
BLKPAN_CRT
BLKPAN_ROTATE4

# ---- ROM map, byte offsets ----
SND_START          =0x080000
PCM_START          =0x088000

[mister]
# Compile out the numeric debug overlay in every MiSTer build.
JTFRAME_RELEASE
BLKPAN_MEAT_CREDITS
JTFRAME_OSD_NOLOGO
JTFRAME_OSD_NOCREDITS
BLKPAN_STANDARD_OSD
BLKPAN_SDRAM_CAPTURE
BLKPAN_DDR_SAFE
JTFRAME_FB_ROTATE
MISTER_FB
JTFRAME_ARX=4
JTFRAME_ARY=3
